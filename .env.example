PORT=3001
NODE_ENV=development

# ─── Monorepo-wide (optional) ────────────────────────────────────────────────
# Click-main `npm run db:seed` — password for seeded admin@collectrx.com (min 12 chars; never logged).
# Set this in repo-root `.env` (collectrx-platform/.env), not in Click-main/.env.
# SEED_ADMIN_PASSWORD=

# Database
MONGODB_URL=mongodb://localhost:27017/collectrx

# SendGrid
SENDGRID_API_KEY=SG.xxxx
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Auth
JWT_SECRET=change-this-to-a-random-64-char-string

# API
API_URL=https://api.collectrx.com
ALLOWED_ORIGINS=https://app.collectrx.com,https://dashboard.collectrx.com
