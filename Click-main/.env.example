# CollectRx Environment Variables
# For DEVELOPMENT ONLY - copy to .env and fill in with your local values
# In production on Railway, secrets are loaded from AWS Parameter Store

# Port (optional, defaults to 3000)
PORT=3000

# Vapi AI API Key (for development: get from https://dashboard.vapi.ai)
# In production: loaded from AWS Parameter Store /collectrx/vapi/api-key
VAPI_API_KEY=your-vapi-api-key-here

# PostgreSQL Database URL (for development: local or Railway connection string)
# In production: loaded from AWS Parameter Store /collectrx/database/url
DATABASE_URL=postgresql://user:password@localhost:5432/collectrx

# Vapi Webhook Secret (for signing webhook callbacks)
# In production: loaded from AWS Parameter Store /collectrx/vapi/webhook-secret
VAPI_WEBHOOK_SECRET=your-webhook-secret-here

# SendGrid API Key (optional, for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Twilio Credentials (optional, for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe Credentials (optional, for payment processing)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Environment (development | production)
NODE_ENV=development

# AWS Region for Parameter Store (if using AWS)
AWS_REGION=us-east-1
