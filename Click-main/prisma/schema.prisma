generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Practice {
  id       String    @id @default(uuid())
  name     String
  timezone String    @default("America/New_York")
  patients Patient[]
  balances Balance[]
  ruleSets RuleSet[]
  users    User[]
}

// ─── Auth & Access Control ────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  practiceId   String
  email        String     @unique
  passwordHash String
  role         String     @default("staff") // admin | manager | staff | readonly
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  practice     Practice   @relation(fields: [practiceId], references: [id])
  auditLogs    AuditLog[]

  @@index([email])
  @@index([practiceId])
}

// ─── HIPAA Audit Logging ──────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  practiceId String?
  action     String   // e.g. READ_PATIENT | CREATE_BALANCE | LOGIN | LOGOUT
  resource   String   // e.g. Patient | Balance | PaymentEvent
  resourceId String?  // the id of the record accessed
  ipAddress  String?
  userAgent  String?
  metadata   String?  // JSON blob for extra context
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([practiceId])
  @@index([action])
  @@index([createdAt])
}

model Patient {
  id               String    @id @default(uuid())
  practiceId       String
  displayName      String
  preferredChannel String    @default("email")
  phoneFake        String
  emailFake        String
  practice         Practice  @relation(fields: [practiceId], references: [id])
  balances         Balance[]
}

model Balance {
  id                String          @id @default(uuid())
  practiceId        String
  patientId         String
  amountCents       Int
  createdAt         DateTime        @default(now())
  dueDate           DateTime
  status            String          @default("OPEN")
  source            String          @default("DENTRIX_SYNC")
  lastDentrixSyncAt DateTime        @default(now())
  practice          Practice        @relation(fields: [practiceId], references: [id])
  patient           Patient         @relation(fields: [patientId], references: [id])
  states            BalanceState[]
  outreachEvents    OutreachEvent[]
  paymentEvents     PaymentEvent[]
}

model BalanceState {
  id        String   @id @default(uuid())
  balanceId String
  stage     String
  stageAt   DateTime @default(now())
  balance   Balance  @relation(fields: [balanceId], references: [id])
}

model OutreachEvent {
  id             String   @id @default(uuid())
  balanceId      String
  channel        String
  templateKey    String
  messageBody    String
  sentAt         DateTime @default(now())
  deliveryStatus String   @default("SENT")
  responseStatus String   @default("NONE")
  balance        Balance  @relation(fields: [balanceId], references: [id])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  balanceId   String
  amountCents Int
  paidAt      DateTime @default(now())
  method      String   @default("LINK")
  result      String   @default("SUCCESS")
  balance     Balance  @relation(fields: [balanceId], references: [id])
}

model RuleSet {
  id         String   @id @default(uuid())
  practiceId String
  name       String
  isActive   Boolean  @default(true)
  practice   Practice @relation(fields: [practiceId], references: [id])
  rules      Rule[]
}

model Rule {
  id           String  @id @default(uuid())
  ruleSetId    String
  trigger      String
  conditions   String
  action       String
  actionParams String
  ruleSet      RuleSet @relation(fields: [ruleSetId], references: [id])
}

model QueuePriority {
  id           String   @id @default(uuid())
  practiceId   String
  carrier      String?
  priorityDate DateTime
  updatedAt    DateTime @updatedAt

  @@unique([practiceId, priorityDate])
}

// ─── Patient AR Models ───────────────────────────────────────────────────────

model PatientBalance {
  id                     String    @id @default(uuid())
  patientToken           String    @default(uuid())
  abeldentPatientId      String?
  patientFirstName       String
  patientLastName        String
  patientEmail           String?
  patientPhone           String?
  carrierCode            String?
  procedureCode          String?
  procedureDescription   String?
  treatmentDate          DateTime?
  adjudicationDate       DateTime?
  amountBilled           Float     @default(0)
  insurancePaid          Float     @default(0)
  patientOwes            Float     @default(0)
  daysSinceAdjudication  Int       @default(0)
  practiceId             String?
  reminderStatus         String    @default("none")
  paymentStatus          String    @default("outstanding")
  amountPaid             Float     @default(0)
  stripePaymentLink      String?
  stripePaymentLinkId    String?
  stripePaymentIntentId  String?
  lastReminderEmailAt    DateTime?
  lastReminderSmsAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([patientToken])
  @@index([paymentStatus])
  @@index([reminderStatus])
  @@index([practiceId])
}

model StripeConnectAccount {
  id                 String   @id @default(uuid())
  practiceId         String   @unique
  stripeAccountId    String   @unique
  onboardingComplete Boolean  @default(false)
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Benefits & Eligibility Models ───────────────────────────────────────────

model PatientBenefits {
  id              String    @id @default(uuid())
  patientToken    String
  carrierCode     String
  planYear        String
  annualMax       Float?
  annualMaxUsed   Float     @default(0)
  deductible      Float     @default(0)
  deductibleMet   Float     @default(0)
  staleFlag       Boolean   @default(false)
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([patientToken, carrierCode, planYear])
  @@index([patientToken])
  @@index([carrierCode])
}

model BenefitCoverage {
  id                   String    @id @default(uuid())
  patientToken         String
  carrierCode          String
  cdtCategory          String
  coveragePct          Float
  waitingPeriodMonths  Int       @default(0)
  waitingPeriodStart   DateTime?
  frequencyLimitMonths Int?
  lastServiceDate      DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([patientToken, carrierCode, cdtCategory])
  @@index([patientToken])
}

model PlanYear {
  id            String   @id @default(uuid())
  patientToken  String
  carrierCode   String
  planYearStart DateTime
  planYearEnd   DateTime
  createdAt     DateTime @default(now())

  @@unique([patientToken, carrierCode, planYearStart])
  @@index([patientToken])
}

model EligibilityCall {
  id           String   @id @default(uuid())
  patientToken String
  carrierCode  String
  vapiCallId   String?
  status       String   @default("initiated")
  outcome      String?
  transcript   String?
  createdAt    DateTime @default(now())

  @@index([patientToken])
}

// ─── Phase 3: Insurance Eligibility Rules Engine ─────────────────────────────

model CdtCode {
  id          String   @id @default(uuid())
  code        String   @unique  // e.g. "D1110"
  description String
  category    String   // preventive | restorative | endodontics | periodontics | prosthodontics | oral_surgery | orthodontics | adjunctive
  subcategory String?
  typicalFee  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([category])
}

model CarrierRule {
  id                   String   @id @default(uuid())
  carrierCode          String   // sun_life | canada_life | manulife | green_shield | rbc_insurance | telus_adjudicare
  version              String   @default("2025")
  deductibleSingle     Float    @default(50)
  deductibleFamily     Float    @default(150)
  annualMaxSingle      Float    @default(1200)
  annualMaxFamily      Float    @default(3600)
  preventivePct        Float    @default(100) // % of eligible fee
  basicPct             Float    @default(80)
  majorPct             Float    @default(50)
  orthodonticPct       Float    @default(50)
  orthodonticLifetimeMax Float?
  preventiveWaiting    Int      @default(0) // months
  basicWaiting         Int      @default(0)
  majorWaiting         Int      @default(0)
  cleaningFreqMonths   Int      @default(6)  // how often cleaning is covered
  examFreqMonths       Int      @default(6)
  xrayBwFreqMonths     Int      @default(12)
  xrayFmxFreqMonths    Int      @default(60)
  sealantAgeLimit      Int?     // max age for sealants
  crownFreqMonths      Int      @default(60)
  isActive             Boolean  @default(true)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([carrierCode, version])
  @@index([carrierCode])
}

model EstimateRecord {
  id                  String   @id @default(uuid())
  patientToken        String
  practiceId          String?
  carrierCode         String
  cdtCode             String
  cdtDescription      String
  cdtCategory         String
  procedureFee        Float
  deductibleApplied   Float    @default(0)
  deductibleRemaining Float    @default(0)
  coveragePct         Float
  insurancePays       Float
  patientPays         Float
  annualMaxRemaining  Float?
  frequencyLimited    Boolean  @default(false)
  frequencyNote       String?
  waitingPeriodActive Boolean  @default(false)
  waitingPeriodNote   String?
  alternativeBenefit  String?
  notes               String?
  createdAt           DateTime @default(now())

  @@index([patientToken])
  @@index([carrierCode])
  @@index([cdtCode])
}

model ReconciliationRecord {
  id                  String   @id @default(uuid())
  estimateId          String?
  patientToken        String
  carrierCode         String
  cdtCode             String
  estimatedInsurance  Float
  actualInsurance     Float
  variance            Float    // actualInsurance - estimatedInsurance
  variancePct         Float    // variance / estimatedInsurance * 100
  status              String   @default("matched") // matched | underpaid | overpaid | denied | pending
  denialReason        String?
  notes               String?
  eobDate             DateTime?
  createdAt           DateTime @default(now())

  @@index([patientToken])
  @@index([carrierCode])
  @@index([status])
}
