{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // GHSA-qwww-vcr4-c8h2 — react-router RSC-mode CSRF bypass (7.12.0-8.2.0).
    // Confirmed against the advisory: it only affects the unstable RSC APIs.
    // This app uses declarative mode only (BrowserRouter/Routes/Route) — not exploitable.
    // The real fix (react-router v8.3.0) requires React 19.2.7+ and Node 22.22+;
    // this app is on React 18 / Node 20, so that's a separate migration, not a quick bump.
    "GHSA-qwww-vcr4-c8h2"
  ]
}
