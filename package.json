{
  "name": "collectrx-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Dental practice accounts receivable automation platform",
  "main": "server.js",
  "workspaces": [
    "Collect-RX-main"
  ],
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "npm run dev:collectrx",
    "dev:collectrx": "npm run dev -w dental-ar-system",
    "build:collectrx": "npm run build -w dental-ar-system",
    "test:collectrx": "npm run test -w dental-ar-system",
    "lint:collectrx": "npm run lint -w dental-ar-system",
    "typecheck:collectrx": "npm run typecheck -w dental-ar-system",
    "db:migrate:collectrx": "npm run db:migrate -w dental-ar-system",
    "db:migrate:dev:collectrx": "npm run db:migrate:dev -w dental-ar-system",
    "db:generate:collectrx": "npm run db:generate -w dental-ar-system",
    "db:seed:collectrx": "npm run db:seed -w dental-ar-system",
    "ci:collectrx": "npm run typecheck:collectrx && npm run lint:collectrx && npm run test:collectrx && npm run build:collectrx",
    "dev:prototype": "NODE_ENV=development node server.js",
    "dev:api": "ts-node --project tsconfig.server.json src/api/server.ts",
    "dev:ui": "vite",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "build:api": "tsc --project tsconfig.server.json",
    "build:ui": "vite build",
    "build": "npm run build:api && npm run build:ui",
    "type-check": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit"
  },
  "keywords": ["dental", "accounts-receivable", "automation", "collections"],
  "author": "CollectRx",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
