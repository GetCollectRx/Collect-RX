#!/usr/bin/env bash
# Runs the full local gate set before code ever reaches GitHub. One entry point, the same
# one used by hand, by Claude Code sessions and by CI parity checks: scripts/verify-all.sh.
#
# Installed automatically via `npm install` (package.json `prepare` sets core.hooksPath to
# this directory). Bypass in a genuine emergency with `git push --no-verify`.
#
# What it runs (see scripts/verify-all.sh --help): scope, any/suppression scan, TODO/FIXME scan,
# secrets scan over the diff AND commit history, whitespace and schema-comment checks, prisma validate and
# generate, migrations on an empty throwaway PostgreSQL 16, RLS coverage, API coverage,
# typecheck, lint, the full test suite, npm audit and the production build.
#
# It starts its own temporary PostgreSQL (local pg16, Docker, or a cached embedded copy) and
# never touches an existing database. First run on a machine without PostgreSQL 16 downloads
# the embedded copy once.
#
# Exit codes: 0 pass, 1 a gate failed, 2 a gate could not run (UNVERIFIED). Both block the push.
# Still CI only: Semgrep, Playwright e2e, perf-smoke, TruffleHog, queue-redis.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ ! -f scripts/verify-all.sh ]; then
  echo "[pre-push] scripts/verify-all.sh is missing; refusing to push without the gate runner." >&2
  exit 1
fi

exec bash scripts/verify-all.sh --full
