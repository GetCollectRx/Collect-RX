{
  "name": "dental-ar-system",
  "version": "1.0.2",
  "description": "CollectRx — dental practice A/R execution (canonical app)",
  "author": "CollectRx",
  "repository": {
    "type": "git",
    "url": "https://github.com/GetCollectRx/Collect-RX.git"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "type": "module",
  "main": "electron-shell/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron-symlink.cjs",
    "dev": "node scripts/dev.mjs",
    "dev:free-ports": "node scripts/free-dev-ports.mjs",
    "dev:backend": "tsx watch src/server/index.ts",
    "dev:frontend": "vite",
    "electron": "npm run dev:electron",
    "dev:electron": "concurrently \"COLLECTRX_DEV_LOCAL=1 npm run dev:backend\" \"COLLECTRX_DEV_LOCAL=1 npm run dev:frontend\" \"wait-on http://localhost:5173 && env -u ELECTRON_RUN_AS_NODE COLLECTRX_DEV_LOCAL=1 electron .\"",
    "check:api": "node scripts/check-api-coverage.mjs",
    "build": "npm run db:generate && tsc && npm run check:api && vite build",
    "build:renderer:desktop": "VITE_APP_SURFACE=desktop vite build",
    "build:win": "npm run db:generate && tsc && npm run check:api && npm run build:renderer:desktop && electron-builder --win",
    "build:mac:swift": "bash scripts/build-macos-swift.sh",
    "install:mac:swift": "bash scripts/install-macos-swift.sh",
    "build:mac:arm64": "env COPYFILE_DISABLE=1 npm run db:generate && tsc && npm run check:api && npm run build:renderer:desktop && env COPYFILE_DISABLE=1 electron-builder --mac --arm64",
    "build:linux": "npm run db:generate && tsc && npm run check:api && npm run build:renderer:desktop && electron-builder --linux",
    "build:desktop": "npm run db:generate && tsc && npm run check:api && npm run build:renderer:desktop && electron-builder --mac --win --linux",
    "start": "tsx src/server/index.ts",
    "worker": "tsx src/server/workerEntry.ts",
    "learning:cycle": "tsx scripts/run-learning-cycle.ts",
    "eval:conversation-robustness": "tsx scripts/run-conversation-robustness-eval.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs && pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:carrier-whitelist": "tsx tests/carrier-whitelist-validation.test.ts",
    "test:agents": "vitest run tests/agents/",
    "agents": "node scripts/run-agents.mjs",
    "agents:report": "node scripts/run-agents.mjs --report",
    "self-tuner": "node scripts/run-self-tuner.mjs",
    "self-tuner:dry-run": "node scripts/run-self-tuner.mjs --dry-run",
    "self-tuner:status": "node scripts/run-self-tuner.mjs --status",
    "diagnose": "node scripts/diagnose-breakage.mjs",
    "diagnose:alert": "node scripts/diagnose-breakage.mjs -- --alert",
    "alert:diagnosis": "tsx scripts/send-ops-alerts.ts",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:staging": "bash scripts/staging-smoke.sh",
    "smoke:staging:product": "node scripts/staging-browser-smoke.mjs",
    "go-live:verify": "node scripts/go-live-verify.mjs",
    "startup-scan": "node scripts/startup-scan.mjs",
    "test:smoke-map": "vitest run tests/smoke/breakage-map.smoke.test.ts",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "e2e:print-id": "tsx scripts/print-e2e-practice-id.ts",
    "db:generate": "prisma generate",
    "db:generate:collectrx": "prisma generate",
    "db:verify-tables": "tsx scripts/verify-db-tables.ts",
    "db:apply-schema-drift": "node scripts/apply-schema-drift-if-needed.mjs",
    "db:inspect-schema": "tsx scripts/inspect-db-schema.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:collectrx": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/server/seed.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "validate:logins": "node scripts/validate-logins.mjs",
    "personas:reset-passwords": "node scripts/set-persona-test-passwords.mjs",
    "db:reset": "prisma migrate reset",
    "check:env": "node scripts/check-deploy-env.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "abeldent:discover": "node scripts/discover-schema.cjs",
    "abeldent:validate-queries": "node scripts/sync-query-builder.cjs --discovery schema-discovery.json --map schema-map.json --validate",
    "abeldent:emit-queries": "node scripts/sync-query-builder.cjs --map schema-map.json --emit-queries queries.generated.json",
    "ivr-research:call": "node scripts/ivr-research/research-call.cjs",
    "vapi:squad-check": "tsx scripts/sync-vapi-squad.ts",
    "vapi:squad-push": "tsx scripts/sync-vapi-squad.ts --push"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1035.0",
    "@clickhouse/client": "^1.19.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@notionhq/client": "^2.3.0",
    "@prisma/client": "^5.8.0",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.50.0",
    "@sentry/react": "^10.50.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.48.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "electron-updater": "^6.3.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.17.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "notebooklm-sdk": "^0.3.4",
    "pg": "^8.11.3",
    "rate-limit-redis": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "stripe": "^21.0.1",
    "tsx": "^4.7.0",
    "twilio": "^5.13.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.51.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.4.38",
    "prisma": "^5.8.0",
    "recharts": "^2.12.0",
    "storybook": "^8.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.collectrx.app",
    "productName": "CollectRx",
    "icon": "electron-shell/icon.png",
    "afterPack": "./electron-shell/afterPack.cjs",
    "afterAllArtifactBuild": "./electron-shell/afterAllArtifactBuild.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-shell/**/*",
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/config/agent-config.example.json",
        "to": "desktop/config/agent-config.example.json"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "GetCollectRx",
        "repo": "Collect-RX"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "identity": "-",
      "timestamp": "none",
      "strictVerify": false,
      "additionalArguments": [
        "--strip-disallowed-xattrs"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CollectRx",
      "include": "electron-shell/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "CollectRx <billing@collectrx.ca>"
    }
  }
}
