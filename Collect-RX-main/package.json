{
  "name": "dental-ar-system",
  "version": "1.0.0",
  "description": "CollectRx — dental practice A/R execution (canonical app)",
  "author": "CollectRx",
  "engines": {
    "node": ">=20.10.0"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron-symlink.cjs",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/server/index.ts",
    "dev:frontend": "vite",
    "dev:electron": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "prisma generate && tsc && vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "env COPYFILE_DISABLE=1 npm run build && env COPYFILE_DISABLE=1 electron-builder --mac",
    "build:mac:arm64": "env COPYFILE_DISABLE=1 npm run build && env COPYFILE_DISABLE=1 electron-builder --mac --arm64",
    "start": "tsx src/server/index.ts",
    "worker": "tsx src/server/workerEntry.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "e2e:print-id": "tsx scripts/print-e2e-practice-id.ts",
    "db:generate": "prisma generate",
    "db:generate:collectrx": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:collectrx": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/server/seed.ts",
    "db:reset": "prisma migrate reset",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "abeldent:discover": "node scripts/discover-schema.cjs",
    "abeldent:validate-queries": "node scripts/sync-query-builder.cjs --discovery schema-discovery.json --map schema-map.json --validate",
    "abeldent:emit-queries": "node scripts/sync-query-builder.cjs --map schema-map.json --emit-queries queries.generated.json"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1035.0",
    "@prisma/client": "^5.8.0",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.50.0",
    "@sentry/react": "^10.50.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.48.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "electron-updater": "^6.3.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "rate-limit-redis": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "stripe": "^21.0.1",
    "twilio": "^5.13.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.51.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.4.38",
    "prisma": "^5.8.0",
    "recharts": "^2.12.0",
    "storybook": "^8.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.collectrx.app",
    "productName": "CollectRx",
    "afterPack": "./electron/afterPack.cjs",
    "afterAllArtifactBuild": "./electron/afterAllArtifactBuild.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CollectRx",
      "include": "electron/installer.nsh"
    }
  }
}
