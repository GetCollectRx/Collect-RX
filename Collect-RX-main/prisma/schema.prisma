generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Practice-layer roles. platform_dev is handled separately (no DB row).
enum PracticeRole {
  practice_owner
  office_manager
  billing_coordinator
  front_desk
  associate_dentist
  accountant
  group_admin
}

model Practice {
  id                             String                    @id @default(uuid())
  name                           String
  timezone                       String                    @default("America/New_York")
  /// Legacy single-practice password hash — kept for migration tooling only. Login now uses User.passwordHash.
  passwordHash                   String
  /// Optional JSON: admin UI prefs (e.g. carrier toggles) — see /api/admin/settings
  settings                       Json?
  // ─── Practice identity fields for carrier calls ───────────────────────────
  /// Billing/claims phone line — what the AI agent reads aloud in the CRTC disclosure
  /// and what carriers call back. Distinct from escalationPhoneNumber in settings (staff takeover).
  billingPhone                   String?                   @map("billing_phone")
  /// Fax number — required by some carriers for documentation / appeal submissions.
  faxNumber                      String?                   @map("fax_number")
  /// Practice mailing address — some carriers ask for this during identity verification.
  practiceAddress                String?                   @map("address")
  /// Provincial college registration / billing number (Canadian NPI equivalent).
  npi                            String?
  /// HST/GST business registration number — some carriers require for payment processing.
  taxId                          String?                   @map("tax_id")
  // ─── Stripe Billing (platform) ────────────────────────────────────────────
  /// Stripe Billing (platform) — practice pays CollectRx. Distinct from Connect Express accounts.
  stripeCustomerId               String?                   @unique
  stripeSubscriptionId           String?                   @unique
  /// Stripe.Subscription.status: active, trialing, past_due, canceled, unpaid, etc.
  subscriptionStatus             String?
  /// Stripe Price and CollectRx plan snapshot used for usage limits.
  subscriptionPriceId            String?
  subscriptionPlanId             String?
  subscriptionCurrentPeriodStart DateTime?
  subscriptionCurrentPeriodEnd   DateTime?
  /// Minutes-based billing (src/billing/tiers.ts) — trial/core/growth/scale.
  billingTier                    BillingTier               @default(trial)
  stripeSubscriptionItemId       String?
  billingPeriodStart             DateTime?
  trialEndsAt                    DateTime?
  callsPaused                    Boolean                   @default(false)
  callsPausedReason              String?
  callsPausedAt                  DateTime?
  overageConfirmed               Boolean                   @default(false)
  overageConfirmedAt             DateTime?
  /// CSV-first practices reconcile recovery from imports and never receive PMS writeback events.
  recoveryMode                   String                    @default("CSV_FIRST") @map("recovery_mode")
  organizationMemberships        OrganizationPractice[]
  partnershipProspect            Prospect?
  ruleSets                       RuleSet[]
  eligibilitySnapshots           EligibilitySnapshot[]
  users                          User[]
  usagePeriods                   UsagePeriod[]
  featureFlags                   FeatureFlag[]
  inviteTokens                   InviteToken[]
  notifications                  PracticeNotification[]
  deletionRequests               PHIPADeletionRequest[]
  breachNotifications            PHIPABreachNotification[]
  phiVaultEntries                PhiVaultEntry[]
  triageCredential               TriageCredential?
  triageAudits                   TriageAudit[]
  padMandate                     PadMandate?
  padTransactions                PadTransaction[]
}

/// Individual user account within a practice (or spanning practices for group_admin).
model User {
  id                      String               @id @default(uuid())
  practiceId              String
  email                   String               @unique
  passwordHash            String
  role                    PracticeRole
  displayName             String
  isActive                Boolean              @default(true)
  /// associate_dentist only — all queries scoped to this provider ID server-side.
  providerId              String?
  /// accountant only — token is invalid after this date; renewable by office_manager.
  tokenExpiresAt          DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  practice                Practice             @relation(fields: [practiceId], references: [id])
  organizationMemberships OrganizationMember[]

  @@index([practiceId])
  @@index([email])
}

/// Customer-owned DSO / multi-location boundary. Platform staff are not members.
model Organization {
  id                String                 @id @default(uuid())
  name              String
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  practices         OrganizationPractice[]
  members           OrganizationMember[]
  inviteTokens      InviteToken[]
  complianceExports OrgComplianceExport[]
  ssoConfig         OrganizationSsoConfig?
  ssoEvents         OrgSsoEvent[]

  // ─── Consolidated Stripe Billing (enterprise/DSO deals) ───────────────────
  /// Set only when the organization itself is billed (enterprise deal) instead
  /// of each member practice billing individually — see billingEntity.ts.
  stripeCustomerId               String?      @unique @map("stripe_customer_id")
  stripeSubscriptionId           String?      @unique @map("stripe_subscription_id")
  subscriptionStatus             String?      @map("subscription_status")
  subscriptionPriceId            String?      @map("subscription_price_id")
  subscriptionPlanId             String?      @map("subscription_plan_id")
  subscriptionCurrentPeriodStart DateTime?    @map("subscription_current_period_start")
  subscriptionCurrentPeriodEnd   DateTime?    @map("subscription_current_period_end")
  /// Minutes-based billing tier (src/billing/tiers.ts) applied to the pooled org.
  billingTier                    BillingTier? @map("billing_tier")
  billingPeriodStart             DateTime?    @map("billing_period_start")
  trialEndsAt                    DateTime?    @map("trial_ends_at")
  callsPaused                    Boolean      @default(false) @map("calls_paused")
  callsPausedReason              String?      @map("calls_paused_reason")
  callsPausedAt                  DateTime?    @map("calls_paused_at")
  overageConfirmed               Boolean      @default(false) @map("overage_confirmed")
  overageConfirmedAt             DateTime?    @map("overage_confirmed_at")
  /// When true (default for an org-billed organization), minutes/cost are evaluated
  /// as one pool across all member practices instead of each practice's own cap.
  cogsPoolingEnabled             Boolean      @default(true) @map("cogs_pooling_enabled")

  @@map("organizations")
}

model OrganizationPractice {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  practiceId     String       @map("practice_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  practice       Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, practiceId])
  @@index([practiceId])
  @@map("organization_practices")
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(org_admin)
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// org_admin manages membership/billing for the DSO; org_member has read-only
/// cross-practice visibility (group dashboards) without admin actions.
enum OrganizationRole {
  org_admin
  org_member
  /// DSO controller/CFO persona — billing visibility only, no claims/PMS/member access.
  org_billing_viewer
}

model RuleSet {
  id         String   @id @default(uuid())
  practiceId String
  name       String
  isActive   Boolean  @default(true)
  practice   Practice @relation(fields: [practiceId], references: [id])
  rules      Rule[]
}

model Rule {
  id           String  @id @default(uuid())
  ruleSetId    String
  trigger      String
  conditions   String
  action       String
  actionParams String
  ruleSet      RuleSet @relation(fields: [ruleSetId], references: [id])
}

model QueuePriority {
  id           String   @id @default(uuid())
  practiceId   String
  carrier      String?
  priorityDate DateTime
  updatedAt    DateTime @updatedAt

  @@unique([practiceId, priorityDate])
}

// Persistent drag-and-drop carrier call order per practice.
// `order` stores a JSON array of carrier codes, e.g.:
//   ["sun_life","canada_life","manulife","green_shield","rbc_insurance","telus_adjudicare"]
// The queue engine calls carriers in this sequence when building a run.
model CarrierOrder {
  id         String   @id @default(uuid())
  practiceId String   @unique
  order      String // JSON-serialised String[]
  updatedAt  DateTime @updatedAt
}

/// Deduplicate Stripe webhook deliveries (id is evt_…).
model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── GoCardless PAD (Pre-Authorized Debit) Billing ───────────────────────────
// Replaces percentage-based Stripe billing with flat-fee-capped ACSS debit
// pulls. GoCardless holds the actual bank account/transit numbers (entered
// on their hosted Billing Request Flow); we only store their billing
// request/customer/mandate/subscription/payment reference IDs.

model ProcessedGoCardlessEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

enum PadMandateStatus {
  pending_authorization
  active
  suspended
  canceled
}

/// Our own internal PAD transaction lifecycle — decoupled from any one processor's
/// exact vocabulary so the vendor can change without touching call sites. See
/// gocardless/padService.ts for the GoCardless status mapping.
enum PadTransactionStatus {
  future
  sent_to_bank
  processed
  approved
  declined
  chargeback
}

/// One PAD mandate per practice. `gocardless*Id` fields are opaque references into
/// GoCardless's system — no raw banking credentials live in our database.
model PadMandate {
  id                         String           @id @default(uuid())
  practiceId                 String           @unique @map("practice_id")
  gocardlessBillingRequestId String           @unique @map("gocardless_billing_request_id")
  gocardlessCustomerId       String?          @unique @map("gocardless_customer_id")
  gocardlessMandateId        String?          @unique @map("gocardless_mandate_id")
  gocardlessSubscriptionId   String?          @unique @map("gocardless_subscription_id")
  status                     PadMandateStatus @default(pending_authorization)
  bankAccountLast4           String?          @map("bank_account_last4")
  /// Monthly SaaS fee this mandate pulls once authorized — the subscription isn't created
  /// until the practice completes their hosted bank authorization and the mandate is active.
  monthlyAmountCents         Int              @map("monthly_amount_cents")
  /// Payments Canada Rule H1 pre-notification window. 10 is the Rule H1 default absent a negotiated
  /// reduction, but GoCardless's own hosted PAD agreement text (confirmed against their sandbox) already
  /// discloses a reduced 3-day period as their platform default for the "pad" scheme — 3 is used here to
  /// match what the payor actually agrees to on GoCardless's page, not our own unconfirmed assumption.
  preNotificationDays        Int              @default(3) @map("pre_notification_days")
  authorizedAt               DateTime?        @map("authorized_at")
  canceledAt                 DateTime?        @map("canceled_at")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  practice     Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  transactions PadTransaction[]

  @@index([status])
  @@map("pad_mandates")
}

model PadTransaction {
  id                    String               @id @default(uuid())
  mandateId             String               @map("mandate_id")
  practiceId            String               @map("practice_id")
  gocardlessPaymentId   String?              @unique @map("gocardless_payment_id")
  amountCents           Int                  @map("amount_cents")
  status                PadTransactionStatus @default(future)
  billingPeriodStart    DateTime             @map("billing_period_start")
  billingPeriodEnd      DateTime             @map("billing_period_end")
  preNotificationSentAt DateTime?            @map("pre_notification_sent_at")
  submittedAt           DateTime?            @map("submitted_at")
  settledAt             DateTime?            @map("settled_at")
  failureReason         String?              @map("failure_reason")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  mandate  PadMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  practice Practice   @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([practiceId])
  @@index([status])
  @@map("pad_transactions")
}

// ─── Benefits & Eligibility Models ───────────────────────────────────────────

model PatientBenefits {
  id             String    @id @default(uuid())
  patientToken   String
  carrierCode    String
  planYear       String
  annualMax      Float?
  annualMaxUsed  Float     @default(0)
  deductible     Float     @default(0)
  deductibleMet  Float     @default(0)
  staleFlag      Boolean   @default(false)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([patientToken, carrierCode, planYear])
  @@index([patientToken])
  @@index([carrierCode])
}

model BenefitCoverage {
  id                   String    @id @default(uuid())
  patientToken         String
  carrierCode          String
  cdtCategory          String
  coveragePct          Float
  waitingPeriodMonths  Int       @default(0)
  waitingPeriodStart   DateTime?
  frequencyLimitMonths Int?
  lastServiceDate      DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([patientToken, carrierCode, cdtCategory])
  @@index([patientToken])
}

model PlanYear {
  id            String   @id @default(uuid())
  patientToken  String
  carrierCode   String
  planYearStart DateTime
  planYearEnd   DateTime
  createdAt     DateTime @default(now())

  @@unique([patientToken, carrierCode, planYearStart])
  @@index([patientToken])
}

model EligibilityCall {
  id           String   @id @default(uuid())
  patientToken String
  carrierCode  String
  vapiCallId   String?
  status       String   @default("initiated")
  outcome      String?
  transcript   String?
  createdAt    DateTime @default(now())

  @@index([patientToken])
}

/// P3-40 — persisted output of POST /api/eligibility/estimate (audit + replay).
model EligibilityEstimateLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  practiceId  String?
  patientId   String
  carrier     String
  requestJson Json
  resultJson  Json

  @@index([patientId, carrier])
  @@index([createdAt])
}

/// P3-42 — persisted output of POST /api/eligibility/reconcile (audit, re-run, compare in UI).
model EligibilityReconcileLog {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  practiceId       String?
  patientId        String
  estimateId       String
  claimId          String?
  adjudicationJson Json
  resultJson       Json

  @@index([estimateId, createdAt])
  @@index([patientId, createdAt])
  @@index([createdAt])
}

/// Vapi delivery ledger. Stores only a SHA-256 body hash and processing state,
/// never the webhook payload, so failed deliveries can be safely retried.
model ProcessedVapiWebhook {
  id                  String    @id @default(cuid())
  bodyHash            String    @unique
  status              String    @default("received")
  attemptCount        Int       @default(0)
  createdAt           DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  failedAt            DateTime?

  @@index([status, createdAt])
}

/// Async claims validator webhook — idempotent processing via body hash
model ProcessedValidatorWebhook {
  id        String   @id @default(cuid())
  bodyHash  String   @unique @map("body_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ProcessedValidatorWebhook")
}

/// Practice notifications — escalations, carrier blocks, payment updates, etc. Displayed on dashboard.
model PracticeNotification {
  id         String    @id @default(cuid())
  practiceId String    @map("practice_id")
  type       String // VALIDATION_ESCALATION, CARRIER_BLOCK, PAYMENT_RECEIVED, PAYMENT_FAILED, CLAIM_DENIED
  subject    String
  message    String
  claimId    String?   @map("claim_id")
  severity   String    @default("info") // info, warning, critical
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  practice Practice        @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  claim    InsuranceClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([practiceId])
  @@index([claimId])
  @@index([readAt])
  @@index([createdAt])
  @@map("PracticeNotification")
}

/// P8-04: one row per automated reminder *attempt* slot (per balance / nextStatus / UTC day) so queue retries do not double-send the same day.
model ReminderSendLedger {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// P5-04: append-only change log (no updates/deletes in app). No PHI in details — summaries only.
model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  practiceId  String
  /// User who performed the action; null for automated system actions or legacy entries.
  userId      String?
  /// e.g. admin.settings.update, admin.csv.import, patient_ar.write_off
  action      String
  subjectType String?
  subjectId   String?
  details     Json?
  /// Request metadata (not body)
  requestIp   String?
  userAgent   String?

  @@index([practiceId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Queryable PHI access trail. Contains identifiers and field categories only,
/// never PHI values, transcript text, or credential material.
model PhiAccessEvent {
  id            String   @id @default(uuid())
  practiceId    String   @map("practice_id")
  actorId       String?  @map("actor_id")
  operation     String
  recordType    String   @map("record_type")
  recordId      String   @map("record_id")
  purpose       String?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([practiceId, createdAt])
  @@index([recordType, recordId])
  @@index([actorId, createdAt])
  @@map("phi_access_events")
}

/// One encrypted credential payload for the practice's pre-call triage channel.
/// The plaintext is never persisted; use triageCredentialService to access it.
model TriageCredential {
  id                       String    @id @default(uuid())
  practiceId               String    @unique @map("practice_id")
  ciphertext               String
  iv                       String
  authTag                  String    @map("auth_tag")
  lastHealthCheckAt        DateTime? @map("last_health_check_at")
  lastHealthCheckStatus    String?   @map("last_health_check_status")
  lastHealthCheckErrorCode String?   @map("last_health_check_error_code")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  practice Practice      @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  audits   TriageAudit[]

  @@map("triage_credentials")
}

/// Append-only security audit for triage credential access. Never stores credential values.
model TriageAudit {
  id            String   @id @default(uuid())
  practiceId    String   @map("practice_id")
  credentialId  String?  @map("credential_id")
  action        String
  actor         String?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  practice   Practice          @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  credential TriageCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([practiceId, createdAt(sort: Desc)])
  @@index([credentialId, createdAt(sort: Desc)])
  @@map("triage_audits")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — Voice AI backend models (added by Phase 5 build)
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum CarrierId {
  sun_life
  canada_life
  manulife
  green_shield
  rbc
  telus_adjudicare

  @@map("carrier_id")
}

enum ClaimStatus {
  PENDING
  IN_QUEUE
  CALLING
  /// Carrier approved / adjudicated in favour but payment not yet received — queue follow-up.
  APPROVED_PENDING_PAYMENT
  RESOLVED
  DENIED
  ESCALATED
  ON_HOLD
  BLOCKED

  @@map("claim_status")
}

enum ClaimPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("claim_priority")
}

/// How the platform routes a claim after a call outcome or sync event.
enum RecoveryRoute {
  CALL_CARRIER
  WAIT_SYNC
  OPEN_CDCP
  PRACTICE_GATE
  STOP

  @@map("recovery_route")
}

enum RecoveryActionType {
  PROCESSING_RECALL
  PAYMENT_TRACE
  PAYMENT_VERIFY_SYNC
  PRACTICE_RESUBMIT
  PRACTICE_DOCS
  CDCP_RECONSIDERATION
  HUMAN_ESCALATION
  DENIAL_REVIEW
  UNDERPAYMENT_REVIEW
  SUBMISSION_QUALITY
  /// Claim is missing required patient data (name, DOB, subscriber ID) — carrier
  /// calls are blocked until staff add the data and clear the gate.
  MISSING_PATIENT_DATA

  @@map("recovery_action_type")
}

enum RecoveryActionStatus {
  OPEN
  BLOCKING
  CLEARED

  @@map("recovery_action_status")
}

enum CallOutcome {
  RESOLVED
  PENDING
  DENIED
  ESCALATED
  BLOCK_DETECTED
  FAILED
  NO_ANSWER
  HUNG_UP

  @@map("call_outcome")
}

enum QueueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ESCALATED
  BLOCKED

  @@map("queue_status")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW TABLES — Phase 5 voice AI backend
// ─────────────────────────────────────────────────────────────────────────────

/// Core claim record. patientToken is a UUID pointing into PIIVault — never
/// stores real patient names, DOBs, or health card numbers.
model InsuranceClaim {
  id                String         @id @default(uuid())
  practiceId        String         @map("practice_id")
  carrierId         CarrierId      @map("carrier_id")
  claimNumber       String         @map("claim_number")
  /// UUID issued by PIIVault — the only patient identifier stored here.
  patientToken      String         @map("patient_token")
  billedAmount      Decimal        @map("billed_amount") @db.Decimal(10, 2)
  outstandingAmount Decimal        @map("outstanding_amount") @db.Decimal(10, 2)
  /// What the practice expected the carrier to pay. When set, the voice agent
  /// uses this when discussing the discrepancy — distinct from outstandingAmount.
  expectedAmount    Decimal?       @map("expected_amount") @db.Decimal(10, 2)
  denialReasonCode  String?        @map("denial_reason_code")
  denialReasonText  String?        @map("denial_reason_text")
  denialDate        DateTime?      @map("denial_date")
  appealDeadline    DateTime?      @map("appeal_deadline")
  daysOutstanding   Int            @map("days_outstanding")
  /// Date of service — canonical anchor for carrier appeal deadlines. Prefer PMS backfill over inferred dates.
  servicedAt        DateTime?      @map("serviced_at")
  /// Date the claim was electronically submitted to the carrier. Carriers ask for this
  /// during calls and it anchors appeal deadline windows.
  submittedAt       DateTime?      @map("submitted_at")
  /// CDT procedure codes billed on this claim, comma-separated (e.g. "D1110,D0274").
  /// Carriers frequently ask "what procedures were included?" during inquiry calls.
  treatmentCodes    String?        @map("treatment_codes")
  status            ClaimStatus    @default(PENDING)
  priority          ClaimPriority  @default(NORMAL)
  /// Active recovery routing — set by claim router after calls/sync.
  recoveryRoute     RecoveryRoute? @map("recovery_route")
  /// When carrier confirmed payment but PMS sync has not yet verified balance drop.
  paymentExpectedBy DateTime?      @map("payment_expected_by")
  /// Soft deletion preserves the claim's immutable recovery and call history.
  /// Application reads and dispatch paths must always exclude deleted claims.
  deletedAt         DateTime?      @map("deleted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  callAttempts      CallAttempt[]
  queueEntry        CallQueue?
  escalations       Escalation[]
  recoveryActions   ClaimRecoveryAction[]
  recoveryEvents    ClaimRecoveryEvent[]
  evidenceItems     ClaimEvidenceItem[]
  submissions       ClaimSubmission[]
  evidencePacks     EvidencePackExport[]
  underpaymentCases UnderpaymentCase[]
  notifications     PracticeNotification[]

  @@unique([practiceId, claimNumber])
  @@index([practiceId, carrierId])
  @@index([practiceId, status])
  @@index([practiceId, deletedAt])
  @@index([carrierId, daysOutstanding])
  @@index([practiceId, status, updatedAt])
  @@map("insurance_claims")
}

/// Open recovery work item — gates re-calls until cleared (resubmit, docs, etc.).
model ClaimRecoveryAction {
  id                String               @id @default(uuid())
  practiceId        String               @map("practice_id")
  claimId           String               @map("claim_id")
  actionType        RecoveryActionType   @map("action_type")
  status            RecoveryActionStatus @default(BLOCKING)
  route             RecoveryRoute
  title             String
  detail            String?
  scheduledRecallAt DateTime?            @map("scheduled_recall_at")
  /// Carrier-imposed deadline for this action (e.g. documentation submission date).
  deadline          DateTime?
  /// When the overdue job should escalate if the action is still open. Defaults
  /// to the deadline at creation time; null means never auto-escalate.
  autoEscalateAt    DateTime?            @map("auto_escalate_at")
  /// Set once the overdue job has escalated — prevents repeat escalations.
  escalatedAt       DateTime?            @map("escalated_at")
  callAttemptId     String?              @map("call_attempt_id")
  cdcpCaseId        String?              @map("cdcp_case_id")
  metadata          Json?
  clearedAt         DateTime?            @map("cleared_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  claim    InsuranceClaim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  cdcpCase CdcpReconsiderationCase? @relation(fields: [cdcpCaseId], references: [id], onDelete: SetNull)

  @@index([claimId, status])
  @@index([practiceId, status])
  @@index([actionType, status, scheduledRecallAt])
  @@index([autoEscalateAt], map: "idx_recovery_actions_auto_escalate")
