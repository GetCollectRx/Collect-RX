/// Chain-of-custody record for auditor-facing org compliance exports
/// (Phase 4 FR-11, GET /api/group/compliance/export/v2) — mirrors
/// EvidencePackExport's pattern: metadata only, never the export contents.
model OrgComplianceExport {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  exportedBy     String       @map("exported_by")
  dateRangeFrom  DateTime     @map("date_range_from")
  dateRangeTo    DateTime     @map("date_range_to")
  checksum       String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("org_compliance_exports")
}

/// Phase 4 FR-1: one SAML 2.0 IdP connection per Organization. IdP SSO URL +
/// signing cert are stored as one authenticated-encrypted blob (reuses the
/// TriageCredential/phiAtRest AES-256-GCM pattern per the PRD's own
/// recommendation) — not because they're confidential (an IdP cert is public),
/// but so tampering with the stored connection is detectable, not just possible.
/// platform_dev-configured only in v1 — no self-serve setup UI.
model OrganizationSsoConfig {
  id              String       @id @default(uuid())
  organizationId  String       @unique @map("organization_id")
  /// URL-safe identifier for the SP-initiated login path (/api/auth/sso/:orgSlug/...).
  orgSlug         String       @unique @map("org_slug")
  ciphertext      String
  iv              String
  authTag         String       @map("auth_tag")
  /// org_admin-controlled (FR-5) — once true, password login is disabled for
  /// any User whose email domain is in enforcedDomains.
  ssoEnforced     Boolean      @default(false) @map("sso_enforced")
  enforcedDomains String[]     @map("enforced_domains")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_sso_configs")
}

/// SSO login failures and admin overrides that AuditLog can't hold (its
/// practiceId is NOT NULL; an unmatched-email SSO failure has no practice to
/// attach to, and enforcement is set/broken at the org level, not a practice's).
/// organizationId is always known here — resolved before any failure branch runs.
model OrgSsoEvent {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  /// 'login_failed' | 'break_glass_disabled'
  eventType      String       @map("event_type")
  /// Failure reason code, or the break-glass justification text.
  detail         String?
  /// platform_dev userId for a break-glass override; null for an anonymous login failure.
  actorUserId    String?      @map("actor_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("org_sso_events")
}

/// Immutable metadata-only evidence pack export record.
model EvidencePackExport {
  id         String         @id @default(uuid())
  practiceId String         @map("practice_id")
  claimId    String         @map("claim_id")
  exportedBy String?        @map("exported_by")
  checksum   String
  format     String         @default("JSON")
  createdAt  DateTime       @default(now()) @map("created_at")
  claim      InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([practiceId, createdAt])
  @@index([claimId])
  @@map("evidence_pack_exports")
}

model UnderpaymentCase {
  id            String         @id @default(uuid())
  practiceId    String         @map("practice_id")
  claimId       String         @map("claim_id")
  expectedCents Int            @map("expected_cents")
  paidCents     Int            @map("paid_cents")
  varianceCents Int            @map("variance_cents")
  reasonCode    String?        @map("reason_code")
  status        String         @default("OPEN")
  createdAt     DateTime       @default(now()) @map("created_at")
  resolvedAt    DateTime?      @map("resolved_at")
  claim         InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, expectedCents, paidCents])
  @@index([practiceId, status])
  @@map("underpayment_cases")
}

/// One row per Vapi call attempt. vapiCallId is unique — used for idempotency.
model CallAttempt {
  id                   String       @id @default(uuid())
  claimId              String       @map("claim_id")
  /// Unique Vapi call identifier — used for idempotent webhook processing.
  vapiCallId           String       @unique @map("vapi_call_id")
  initiatedAt          DateTime     @map("initiated_at")
  completedAt          DateTime?    @map("completed_at")
  durationSeconds      Int?         @map("duration_seconds")
  /// ceil(durationSeconds / 60) — the value applied against UsagePeriod.minutesConsumed.
  minutesBilled        Int?         @map("minutes_billed")
  outcome              CallOutcome?
  outcomeDetail        String?      @map("outcome_detail")
  repName              String?      @map("rep_name")
  referenceNumber      String?      @map("reference_number")
  transcriptUrl        String?      @map("transcript_url")
  /// Full transcript text from Vapi (persisted by guardrails layer)
  transcriptText       String?      @map("transcript_text")
  /// ISO timestamp set once the 8-dimension automated evaluation has been written.
  /// Null means the call has not yet been evaluated. Used by the zero-retention
  /// audio deletion gate (pii-vault.ts) and the eval-scores analytics endpoint.
  evalCompletedAt      DateTime?    @map("eval_completed_at")
  /// JSON-serialised DimensionScore[] from automated-eval.ts.
  /// Null until evalCompletedAt is set. No PHI — scores and rationale only.
  evalScores           String?      @map("eval_scores")
  /// True if this call triggered the CARRIER_BLOCK protocol.
  carrierBlockDetected Boolean      @default(false) @map("carrier_block_detected")
  /// True when the carrier kept the agent waiting past the hold threshold and
  /// still ended the call with no engagement (no rep, no reference number).
  heldThenDumped       Boolean      @default(false) @map("held_then_dumped")
  /// Live console state while call is in progress (cleared on completion).
  liveState            String?      @map("live_state")
  activeAgent          String?      @map("active_agent")
  pausedByStaffAt      DateTime?    @map("paused_by_staff_at")
  pausedByStaffId      String?      @map("paused_by_staff_id")
  takenOverByStaffAt   DateTime?    @map("taken_over_by_staff_at")
  takenOverByStaffId   String?      @map("taken_over_by_staff_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  /// Async validator webhook result — true if validation passed, false if escalated
  validationPassed     Boolean?     @map("validation_passed")
  /// Full validator output JSON (violations, safety_score, carrier_block_risk, etc.)
  validationResult     Json?        @map("validation_result")

  claim           InsuranceClaim        @relation(fields: [claimId], references: [id])
  guardrailAudits GuardrailAudit[]
  guardrailOutbox GuardrailAuditOutbox?

  @@index([claimId])
  @@index([vapiCallId])
  @@index([outcome])
  @@index([initiatedAt(sort: Desc)])
  @@map("call_attempts")
}

/// Real-time transcript lines for the front desk live console (practice-scoped).
model CallTranscriptLine {
  id         String   @id @default(uuid())
  practiceId String   @map("practice_id")
  vapiCallId String   @map("vapi_call_id")
  speaker    String
  agentName  String?  @map("agent_name")
  text       String
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([vapiCallId, recordedAt])
  @@index([practiceId, vapiCallId])
  @@map("call_transcript_lines")
}

/// Per-practice front desk queue controls (pause/resume).
model PracticeDeskState {
  practiceId  String   @id @map("practice_id")
  queuePaused Boolean  @default(false) @map("queue_paused")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("practice_desk_state")
}

/// Written when a carrier detects automation. Triggers practice-wide suspension
/// of ALL calls to that carrier until resumedAt is set.
/// This is the highest-risk operational event — must fire on every block signal.
model CarrierBlockEvent {
  id         String    @id @default(uuid())
  practiceId String    @map("practice_id")
  carrierId  CarrierId @map("carrier_id")
  blockedAt  DateTime  @default(now()) @map("blocked_at")
  resumedAt  DateTime? @map("resumed_at")
  resumedBy  String?   @map("resumed_by")
  notes      String?

  @@index([practiceId, carrierId, blockedAt(sort: Desc)])
  @@index([resumedAt]) // null = still active block
  @@map("carrier_block_events")
}

/// One row per claim in the call queue. Tracks scheduling, retry count, state.
model CallQueue {
  id                         String        @id @default(uuid())
  practiceId                 String        @map("practice_id")
  claimId                    String        @unique @map("claim_id")
  scheduledFor               DateTime      @map("scheduled_for")
  priority                   ClaimPriority @default(NORMAL)
  /// Number of attempts made so far. Hard cap: 3 (enforced before dispatch).
  attempts                   Int           @default(0)
  lastAttemptAt              DateTime?     @map("last_attempt_at")
  /// Next scheduled recall time after this claim's outcome (set by claim router).
  nextRecallAt               DateTime?     @map("next_recall_at")
  /// Safe, structured reason for the latest dispatch deferral. Never stores PHI or vendor errors.
  dispatchDeferralCode       String?       @map("dispatch_deferral_code")
  /// Staff-facing next step for the latest dispatch deferral. Never stores PHI.
  dispatchDeferralNextAction String?       @map("dispatch_deferral_next_action")
  dispatchDeferredAt         DateTime?     @map("dispatch_deferred_at")
  status                     QueueStatus   @default(PENDING)
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  claim InsuranceClaim @relation(fields: [claimId], references: [id])

  @@index([practiceId, status])
  @@index([scheduledFor])
  @@index([practiceId, priority, scheduledFor])
  @@index([practiceId, status, updatedAt])
  @@map("call_queue")
}

/// Outbound events for practice EMR / PMS connectors (AbelDent, etc.). Worker drains `processedAt IS NULL`.
model EmrSyncOutbox {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  practiceId  String    @map("practice_id")
  claimId     String    @map("claim_id")
  eventType   String    @map("event_type")
  payloadJson Json      @map("payload_json")
  processedAt DateTime? @map("processed_at")

  @@index([practiceId, createdAt(sort: Desc)])
  @@index([claimId])
  @@index([processedAt])
  @@map("emr_sync_outbox")
}

