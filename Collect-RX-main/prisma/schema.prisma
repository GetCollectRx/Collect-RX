  PROPOSED
  APPROVED
  REJECTED

  @@map("carrier_lesson_status")
}

/// A lesson extracted from a call transcript by the learning loop.
/// Platform-wide knowledge (keyed by carrier, shared across practices) and
/// must never contain PHI or practice-identifying data — the extractor
/// scrubs, and only human-APPROVED lessons are ever injected into live
/// call instructions (transcripts are untrusted input).
model CarrierLesson {
  id                  String                @id @default(uuid())
  carrierId           CarrierId             @map("carrier_id")
  category            CarrierLessonCategory
  observation         String
  recommendation      String
  confidence          Float                 @default(0)
  status              CarrierLessonStatus   @default(PROPOSED)
  /// Audit trail only — the lesson content itself is tenant-free.
  sourceCallAttemptId String?               @map("source_call_attempt_id")
  reviewedAt          DateTime?             @map("reviewed_at")
  reviewedBy          String?               @map("reviewed_by")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([carrierId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("carrier_lessons")
}

