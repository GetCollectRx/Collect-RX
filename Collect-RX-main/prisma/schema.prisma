generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Practice {
  id            String    @id @default(uuid())
  name          String
  timezone      String    @default("America/New_York")
  // bcrypt/argon2 hash; required for /api/auth/login
  passwordHash  String
  /// Optional JSON: admin UI prefs (e.g. carrier toggles) — see /api/admin/settings
  settings      Json?
  patients      Patient[]
  balances      Balance[]
  ruleSets      RuleSet[]
}

model Patient {
  id               String    @id @default(uuid())
  practiceId       String
  displayName      String
  preferredChannel String    @default("email")
  phoneFake        String
  emailFake        String
  practice         Practice  @relation(fields: [practiceId], references: [id])
  balances         Balance[]
}

model Balance {
  id                String          @id @default(uuid())
  practiceId        String
  patientId         String
  amountCents       Int
  createdAt         DateTime        @default(now())
  dueDate           DateTime
  status            String          @default("OPEN")
  source            String          @default("DENTRIX_SYNC")
  lastDentrixSyncAt DateTime        @default(now())
  practice          Practice        @relation(fields: [practiceId], references: [id])
  patient           Patient         @relation(fields: [patientId], references: [id])
  states            BalanceState[]
  outreachEvents    OutreachEvent[]
  paymentEvents     PaymentEvent[]
}

model BalanceState {
  id        String   @id @default(uuid())
  balanceId String
  stage     String
  stageAt   DateTime @default(now())
  balance   Balance  @relation(fields: [balanceId], references: [id])
}

model OutreachEvent {
  id             String   @id @default(uuid())
  balanceId      String
  channel        String
  templateKey    String
  messageBody    String
  sentAt         DateTime @default(now())
  deliveryStatus String   @default("SENT")
  responseStatus String   @default("NONE")
  balance        Balance  @relation(fields: [balanceId], references: [id])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  balanceId   String
  amountCents Int
  paidAt      DateTime @default(now())
  method      String   @default("LINK")
  result      String   @default("SUCCESS")
  balance     Balance  @relation(fields: [balanceId], references: [id])
}

model RuleSet {
  id         String   @id @default(uuid())
  practiceId String
  name       String
  isActive   Boolean  @default(true)
  practice   Practice @relation(fields: [practiceId], references: [id])
  rules      Rule[]
}

model Rule {
  id           String  @id @default(uuid())
  ruleSetId    String
  trigger      String
  conditions   String
  action       String
  actionParams String
  ruleSet      RuleSet @relation(fields: [ruleSetId], references: [id])
}

model QueuePriority {
  id           String   @id @default(uuid())
  practiceId   String
  carrier      String?
  priorityDate DateTime
  updatedAt    DateTime @updatedAt

  @@unique([practiceId, priorityDate])
}

// Persistent drag-and-drop carrier call order per practice.
// `order` stores a JSON array of carrier codes, e.g.:
//   ["sun_life","canada_life","manulife","green_shield","rbc_insurance","telus_adjudicare"]
// The queue engine calls carriers in this sequence when building a run.
model CarrierOrder {
  id         String   @id @default(uuid())
  practiceId String   @unique
  order      String   // JSON-serialised String[]
  updatedAt  DateTime @updatedAt
}

// ─── Patient AR Models ───────────────────────────────────────────────────────

model PatientBalance {
  id                     String    @id @default(uuid())
  patientToken           String    @default(uuid())
  abeldentPatientId      String?
  patientFirstName       String
  patientLastName        String
  patientEmail           String?
  patientPhone           String?
  carrierCode            String?
  procedureCode          String?
  procedureDescription   String?
  treatmentDate          DateTime?
  adjudicationDate       DateTime?
  amountBilled           Float     @default(0)
  insurancePaid          Float     @default(0)
  patientOwes            Float     @default(0)
  daysSinceAdjudication  Int       @default(0)
  practiceId             String?
  reminderStatus         String    @default("none")
  paymentStatus          String    @default("outstanding")
  amountPaid             Float     @default(0)
  stripePaymentLink      String?
  stripePaymentLinkId    String?
  stripePaymentIntentId  String?
  /// Opaque token for /pay/p/:token (no staff session). See PUBLIC_PAY_TOKEN_TTL_DAYS.
  publicPayToken         String?   @unique
  publicPayTokenExpiresAt DateTime?
  lastReminderEmailAt    DateTime?
  lastReminderSmsAt      DateTime?
  /// P4-03: set when patient texts STOP to Twilio inbound; blocks future SMS to patientPhone.
  smsOptOutAt            DateTime?
  /// P4-02: set on one-click unsubscribe or SendGrid spam/bounce; blocks balance reminder email.
  emailOptOutAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([patientToken])
  @@index([paymentStatus])
  @@index([reminderStatus])
  @@index([practiceId])
  @@index([emailOptOutAt])
}

model StripeConnectAccount {
  id                 String   @id @default(uuid())
  practiceId         String   @unique
  stripeAccountId    String   @unique
  onboardingComplete Boolean  @default(false)
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Deduplicate Stripe webhook deliveries (id is evt_…).
model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── Benefits & Eligibility Models ───────────────────────────────────────────

model PatientBenefits {
  id              String    @id @default(uuid())
  patientToken    String
  carrierCode     String
  planYear        String
  annualMax       Float?
  annualMaxUsed   Float     @default(0)
  deductible      Float     @default(0)
  deductibleMet   Float     @default(0)
  staleFlag       Boolean   @default(false)
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([patientToken, carrierCode, planYear])
  @@index([patientToken])
  @@index([carrierCode])
}

model BenefitCoverage {
  id                   String    @id @default(uuid())
  patientToken         String
  carrierCode          String
  cdtCategory          String
  coveragePct          Float
  waitingPeriodMonths  Int       @default(0)
  waitingPeriodStart   DateTime?
  frequencyLimitMonths Int?
  lastServiceDate      DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([patientToken, carrierCode, cdtCategory])
  @@index([patientToken])
}

model PlanYear {
  id            String   @id @default(uuid())
  patientToken  String
  carrierCode   String
  planYearStart DateTime
  planYearEnd   DateTime
  createdAt     DateTime @default(now())

  @@unique([patientToken, carrierCode, planYearStart])
  @@index([patientToken])
}

model EligibilityCall {
  id           String   @id @default(uuid())
  patientToken String
  carrierCode  String
  vapiCallId   String?
  status       String   @default("initiated")
  outcome      String?
  transcript   String?
  createdAt    DateTime @default(now())

  @@index([patientToken])
}

/// P3-40 — persisted output of POST /api/eligibility/estimate (audit + replay).
model EligibilityEstimateLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  practiceId  String?
  patientId   String
  carrier     String
  requestJson Json
  resultJson  Json

  @@index([patientId, carrier])
  @@index([createdAt])
}

/// P3-42 — persisted output of POST /api/eligibility/reconcile (audit, re-run, compare in UI).
model EligibilityReconcileLog {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  practiceId       String?
  patientId        String
  estimateId       String
  claimId          String?
  adjudicationJson Json
  resultJson       Json

  @@index([estimateId, createdAt])
  @@index([patientId, createdAt])
  @@index([createdAt])
}

/// P4-05: Vapi may retry the same server POST; dedupe by body hash to avoid double-processing.
model ProcessedVapiWebhook {
  id        String   @id @default(cuid())
  bodyHash  String   @unique
  createdAt DateTime @default(now())
}

/// P8-04: one row per automated reminder *attempt* slot (per balance / nextStatus / UTC day) so queue retries do not double-send the same day.
model ReminderSendLedger {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// P5-04: append-only change log (no updates/deletes in app). No PHI in details — summaries only.
model AuditLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  practiceId   String
  /// e.g. admin.settings.update, admin.csv.import, patient_ar.write_off
  action       String
  subjectType  String?
  subjectId    String?
  details      Json?
  /// Request metadata (not body)
  requestIp     String?
  userAgent  String?

  @@index([practiceId, createdAt])
  @@index([createdAt])
}
