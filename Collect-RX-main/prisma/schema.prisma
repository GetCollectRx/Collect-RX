  createdAt   DateTime  @default(now()) @map("created_at")

  proposalsBase      CarrierNavigationProposal[] @relation("ProposalBaseSnapshot")
  proposalsPublished CarrierNavigationProposal[] @relation("ProposalPublishedSnapshot")

  @@unique([carrierId, version])
  @@index([carrierId, publishedAt(sort: Desc)])
  @@map("carrier_navigation_snapshots")
}

/// An untrusted, transcript-derived recommendation. Approval creates a new
/// immutable snapshot; it can never alter an existing published version.
model CarrierNavigationProposal {
  id                  String                          @id @default(uuid())
  carrierId           CarrierId                       @map("carrier_id")
  discoveryRunId      String?                         @map("discovery_run_id")
  baseSnapshotId      String?                         @map("base_snapshot_id")
  proposedNavigation  Json                            @map("proposed_navigation")
  proposedSummary     String                          @map("proposed_summary")
  diff                Json
  evidence            String?                         @map("evidence")
  confidence          Float                           @default(0)
  status              CarrierNavigationProposalStatus @default(PROPOSED)
  reviewedAt          DateTime?                       @map("reviewed_at")
  reviewedBy          String?                         @map("reviewed_by")
  reviewNotes         String?                         @map("review_notes")
  publishedSnapshotId String?                         @unique @map("published_snapshot_id")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")

  discoveryRun      CarrierDiscoveryRun?       @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  baseSnapshot      CarrierNavigationSnapshot? @relation("ProposalBaseSnapshot", fields: [baseSnapshotId], references: [id], onDelete: SetNull)
  publishedSnapshot CarrierNavigationSnapshot? @relation("ProposalPublishedSnapshot", fields: [publishedSnapshotId], references: [id], onDelete: SetNull)

  @@index([carrierId, status, createdAt(sort: Desc)])
  @@index([discoveryRunId])
  @@map("carrier_navigation_proposals")
}

model Escalation {
  id             String   @id @default(uuid())
  claimId        String   @map("claim_id")
  claim          InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  type           String   // SENTIMENT_DISTRESS, MANUAL, CARRIER_RESPONSE, etc.
  severity       String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  reason         String   @map("reason") @db.Text
  metadata       Json?
  status         String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt      DateTime @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")
  resolution     String?  @db.Text

  @@index([claimId, status])
  @@index([createdAt(sort: Desc)])
  @@map("escalations")
}

model EmailCampaignEvent {
  id             String   @id @default(uuid())
  prospectId     String   @map("prospect_id")
  prospect       Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  eventType      String   @map("event_type") // sent, opened, clicked, replied, bounced, unsubscribed
  eventTimestamp DateTime @default(now()) @map("event_timestamp")
  emailSubject   String?  @map("email_subject")
  replyBody      String?  @map("reply_body") @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([prospectId])
  @@index([eventTimestamp])
  @@index([eventType])
  @@map("email_campaign_events")
}
