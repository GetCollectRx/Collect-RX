generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Practice-layer roles. platform_dev is handled separately (no DB row).
enum PracticeRole {
  practice_owner
  office_manager
  billing_coordinator
  front_desk
  associate_dentist
  accountant
  group_admin
}

model Practice {
  id            String    @id @default(uuid())
  name          String
  timezone      String    @default("America/New_York")
  /// Legacy single-practice password hash — kept for migration tooling only. Login now uses User.passwordHash.
  passwordHash  String
  /// Optional JSON: admin UI prefs (e.g. carrier toggles) — see /api/admin/settings
  settings      Json?
  /// Stripe Billing (platform) — practice pays CollectRx. Distinct from Connect Express accounts.
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  /// Stripe.Subscription.status: active, trialing, past_due, canceled, unpaid, etc.
  subscriptionStatus           String?
  /// Stripe Price and CollectRx plan snapshot used for usage limits.
  subscriptionPriceId          String?
  subscriptionPlanId           String?
  subscriptionCurrentPeriodStart DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  patients              Patient[]
  balances              Balance[]
  ruleSets              RuleSet[]
  eligibilitySnapshots  EligibilitySnapshot[]
  users                 User[]
}

/// Individual user account within a practice (or spanning practices for group_admin).
model User {
  id           String       @id @default(uuid())
  practiceId   String
  email        String       @unique
  passwordHash String
  role         PracticeRole
  displayName  String
  isActive     Boolean      @default(true)
  /// associate_dentist only — all queries scoped to this provider ID server-side.
  providerId   String?
  /// accountant only — token is invalid after this date; renewable by office_manager.
  tokenExpiresAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  practice     Practice     @relation(fields: [practiceId], references: [id])

  @@index([practiceId])
  @@index([email])
}

model Patient {
  id               String    @id @default(uuid())
  practiceId       String
  displayName      String
  preferredChannel String    @default("email")
  phoneFake        String
  emailFake        String
  practice         Practice  @relation(fields: [practiceId], references: [id])
  balances         Balance[]
}

model Balance {
  id                String          @id @default(uuid())
  practiceId        String
  patientId         String
  amountCents       Int
  createdAt         DateTime        @default(now())
  dueDate           DateTime
  status            String          @default("OPEN")
  source            String          @default("DENTRIX_SYNC")
  lastDentrixSyncAt DateTime        @default(now())
  practice          Practice        @relation(fields: [practiceId], references: [id])
  patient           Patient         @relation(fields: [patientId], references: [id])
  states            BalanceState[]
  outreachEvents    OutreachEvent[]
  paymentEvents     PaymentEvent[]
}

model BalanceState {
  id        String   @id @default(uuid())
  balanceId String
  stage     String
  stageAt   DateTime @default(now())
  balance   Balance  @relation(fields: [balanceId], references: [id])
}

model OutreachEvent {
  id             String   @id @default(uuid())
  balanceId      String
  channel        String
  templateKey    String
  messageBody    String
  sentAt         DateTime @default(now())
  deliveryStatus String   @default("SENT")
  responseStatus String   @default("NONE")
  balance        Balance  @relation(fields: [balanceId], references: [id])
}

model PaymentEvent {
  id          String   @id @default(uuid())
  balanceId   String
  amountCents Int
  paidAt      DateTime @default(now())
  method      String   @default("LINK")
  result      String   @default("SUCCESS")
  balance     Balance  @relation(fields: [balanceId], references: [id])
}

model RuleSet {
  id         String   @id @default(uuid())
  practiceId String
  name       String
  isActive   Boolean  @default(true)
  practice   Practice @relation(fields: [practiceId], references: [id])
  rules      Rule[]
}

model Rule {
  id           String  @id @default(uuid())
  ruleSetId    String
  trigger      String
  conditions   String
  action       String
  actionParams String
  ruleSet      RuleSet @relation(fields: [ruleSetId], references: [id])
}

model QueuePriority {
  id           String   @id @default(uuid())
  practiceId   String
  carrier      String?
  priorityDate DateTime
  updatedAt    DateTime @updatedAt

  @@unique([practiceId, priorityDate])
}

// Persistent drag-and-drop carrier call order per practice.
// `order` stores a JSON array of carrier codes, e.g.:
//   ["sun_life","canada_life","manulife","green_shield","rbc_insurance","telus_adjudicare"]
// The queue engine calls carriers in this sequence when building a run.
model CarrierOrder {
  id         String   @id @default(uuid())
  practiceId String   @unique
  order      String   // JSON-serialised String[]
  updatedAt  DateTime @updatedAt
}

// ─── Patient AR Models ───────────────────────────────────────────────────────

model PatientBalance {
  id                     String    @id @default(uuid())
  patientToken           String    @default(uuid())
  abeldentPatientId      String?
  patientFirstName       String
  patientLastName        String
  patientEmail           String?
  patientPhone           String?
  carrierCode            String?
  procedureCode          String?
  procedureDescription   String?
  treatmentDate          DateTime?
  adjudicationDate       DateTime?
  amountBilled           Float     @default(0)
  insurancePaid          Float     @default(0)
  patientOwes            Float     @default(0)
  daysSinceAdjudication  Int       @default(0)
  practiceId             String?
  reminderStatus         String    @default("none")
  paymentStatus          String    @default("outstanding")
  amountPaid             Float     @default(0)
  stripePaymentLink      String?
  stripePaymentLinkId    String?
  stripePaymentIntentId  String?
  /// Opaque token for /pay/p/:token (no staff session). See PUBLIC_PAY_TOKEN_TTL_DAYS.
  publicPayToken         String?   @unique
  publicPayTokenExpiresAt DateTime?
  lastReminderEmailAt    DateTime?
  lastReminderSmsAt      DateTime?
  /// P4-03: set when patient texts STOP to Twilio inbound; blocks future SMS to patientPhone.
  smsOptOutAt            DateTime?
  /// P4-02: set on one-click unsubscribe or SendGrid spam/bounce; blocks balance reminder email.
  emailOptOutAt          DateTime?
  /// Associate Dentist scoping — populated by AbelDent sync; null means unassigned.
  providerId             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([patientToken])
  @@index([paymentStatus])
  @@index([reminderStatus])
  @@index([practiceId])
  @@index([providerId])
  @@index([emailOptOutAt])
  @@index([patientPhone])
}

model StripeConnectAccount {
  id                 String   @id @default(uuid())
  practiceId         String   @unique
  stripeAccountId    String   @unique
  onboardingComplete Boolean  @default(false)
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Deduplicate Stripe webhook deliveries (id is evt_…).
model ProcessedStripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── Benefits & Eligibility Models ───────────────────────────────────────────

model PatientBenefits {
  id              String    @id @default(uuid())
  patientToken    String
  carrierCode     String
  planYear        String
  annualMax       Float?
  annualMaxUsed   Float     @default(0)
  deductible      Float     @default(0)
  deductibleMet   Float     @default(0)
  staleFlag       Boolean   @default(false)
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([patientToken, carrierCode, planYear])
  @@index([patientToken])
  @@index([carrierCode])
}

model BenefitCoverage {
  id                   String    @id @default(uuid())
  patientToken         String
  carrierCode          String
  cdtCategory          String
  coveragePct          Float
  waitingPeriodMonths  Int       @default(0)
  waitingPeriodStart   DateTime?
  frequencyLimitMonths Int?
  lastServiceDate      DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([patientToken, carrierCode, cdtCategory])
  @@index([patientToken])
}

model PlanYear {
  id            String   @id @default(uuid())
  patientToken  String
  carrierCode   String
  planYearStart DateTime
  planYearEnd   DateTime
  createdAt     DateTime @default(now())

  @@unique([patientToken, carrierCode, planYearStart])
  @@index([patientToken])
}

model EligibilityCall {
  id           String   @id @default(uuid())
  patientToken String
  carrierCode  String
  vapiCallId   String?
  status       String   @default("initiated")
  outcome      String?
  transcript   String?
  createdAt    DateTime @default(now())

  @@index([patientToken])
}

/// P3-40 — persisted output of POST /api/eligibility/estimate (audit + replay).
model EligibilityEstimateLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  practiceId  String?
  patientId   String
  carrier     String
  requestJson Json
  resultJson  Json

  @@index([patientId, carrier])
  @@index([createdAt])
}

/// P3-42 — persisted output of POST /api/eligibility/reconcile (audit, re-run, compare in UI).
model EligibilityReconcileLog {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  practiceId       String?
  patientId        String
  estimateId       String
  claimId          String?
  adjudicationJson Json
  resultJson       Json

  @@index([estimateId, createdAt])
  @@index([patientId, createdAt])
  @@index([createdAt])
}

/// P4-05: Vapi may retry the same server POST; dedupe by body hash to avoid double-processing.
model ProcessedVapiWebhook {
  id        String   @id @default(cuid())
  bodyHash  String   @unique
  createdAt DateTime @default(now())
}

/// P8-04: one row per automated reminder *attempt* slot (per balance / nextStatus / UTC day) so queue retries do not double-send the same day.
model ReminderSendLedger {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// P5-04: append-only change log (no updates/deletes in app). No PHI in details — summaries only.
model AuditLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  practiceId   String
  /// User who performed the action; null for automated system actions or legacy entries.
  userId       String?
  /// e.g. admin.settings.update, admin.csv.import, patient_ar.write_off
  action       String
  subjectType  String?
  subjectId    String?
  details      Json?
  /// Request metadata (not body)
  requestIp     String?
  userAgent  String?

  @@index([practiceId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}


// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — Voice AI backend models (added by Phase 5 build)
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum CarrierId {
  sun_life
  canada_life
  manulife
  green_shield
  rbc
  telus_adjudicare

  @@map("carrier_id")
}

enum ClaimStatus {
  PENDING
  IN_QUEUE
  CALLING
  /// Carrier approved / adjudicated in favour but payment not yet received — queue follow-up.
  APPROVED_PENDING_PAYMENT
  RESOLVED
  DENIED
  ESCALATED
  ON_HOLD
  BLOCKED

  @@map("claim_status")
}

enum ClaimPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("claim_priority")
}

enum CallOutcome {
  RESOLVED
  PENDING
  DENIED
  ESCALATED
  BLOCK_DETECTED
  FAILED
  NO_ANSWER
  HUNG_UP

  @@map("call_outcome")
}

enum QueueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ESCALATED
  BLOCKED

  @@map("queue_status")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW TABLES — Phase 5 voice AI backend
// ─────────────────────────────────────────────────────────────────────────────

/// Core claim record. patientToken is a UUID pointing into PIIVault — never
/// stores real patient names, DOBs, or health card numbers.
model InsuranceClaim {
  id                String        @id @default(uuid())
  practiceId        String        @map("practice_id")
  carrierId         CarrierId     @map("carrier_id")
  claimNumber       String        @map("claim_number")
  /// UUID issued by PIIVault — the only patient identifier stored here.
  patientToken      String        @map("patient_token")
  billedAmount      Decimal       @map("billed_amount") @db.Decimal(10, 2)
  outstandingAmount Decimal       @map("outstanding_amount") @db.Decimal(10, 2)
  daysOutstanding   Int           @map("days_outstanding")
  /// Date of service — canonical anchor for carrier appeal deadlines. Prefer PMS backfill over inferred dates.
  servicedAt        DateTime?     @map("serviced_at")
  status            ClaimStatus   @default(PENDING)
  priority          ClaimPriority @default(NORMAL)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  callAttempts CallAttempt[]
  queueEntry   CallQueue?

  @@unique([practiceId, claimNumber])
  @@index([practiceId, carrierId])
  @@index([practiceId, status])
  @@index([carrierId, daysOutstanding])
  @@map("insurance_claims")
}

/// One row per Vapi call attempt. vapiCallId is unique — used for idempotency.
model CallAttempt {
  id                   String      @id @default(uuid())
  claimId              String      @map("claim_id")
  /// Unique Vapi call identifier — used for idempotent webhook processing.
  vapiCallId           String      @unique @map("vapi_call_id")
  initiatedAt          DateTime    @map("initiated_at")
  completedAt          DateTime?   @map("completed_at")
  durationSeconds      Int?        @map("duration_seconds")
  outcome              CallOutcome?
  outcomeDetail        String?     @map("outcome_detail")
  repName              String?     @map("rep_name")
  referenceNumber      String?     @map("reference_number")
  transcriptUrl        String?     @map("transcript_url")
  /// True if this call triggered the CARRIER_BLOCK protocol.
  carrierBlockDetected Boolean     @default(false) @map("carrier_block_detected")
  /// Live console state while call is in progress (cleared on completion).
  liveState            String?     @map("live_state")
  activeAgent          String?     @map("active_agent")
  pausedByStaffAt      DateTime?   @map("paused_by_staff_at")
  pausedByStaffId      String?     @map("paused_by_staff_id")
  takenOverByStaffAt   DateTime?   @map("taken_over_by_staff_at")
  takenOverByStaffId   String?     @map("taken_over_by_staff_id")
  createdAt            DateTime    @default(now()) @map("created_at")

  claim InsuranceClaim @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@index([vapiCallId])
  @@index([outcome])
  @@index([initiatedAt(sort: Desc)])
  @@map("call_attempts")
}

/// Real-time transcript lines for the front desk live console (practice-scoped).
model CallTranscriptLine {
  id         String   @id @default(uuid())
  practiceId String   @map("practice_id")
  vapiCallId String   @map("vapi_call_id")
  speaker    String
  agentName  String?  @map("agent_name")
  text       String
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([vapiCallId, recordedAt])
  @@index([practiceId, vapiCallId])
  @@map("call_transcript_lines")
}

/// Per-practice front desk queue controls (pause/resume).
model PracticeDeskState {
  practiceId  String   @id @map("practice_id")
  queuePaused Boolean  @default(false) @map("queue_paused")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("practice_desk_state")
}

/// Written when a carrier detects automation. Triggers practice-wide suspension
/// of ALL calls to that carrier until resumedAt is set.
/// This is the highest-risk operational event — must fire on every block signal.
model CarrierBlockEvent {
  id         String    @id @default(uuid())
  practiceId String    @map("practice_id")
  carrierId  CarrierId @map("carrier_id")
  blockedAt  DateTime  @default(now()) @map("blocked_at")
  resumedAt  DateTime? @map("resumed_at")
  resumedBy  String?   @map("resumed_by")
  notes      String?

  @@index([practiceId, carrierId, blockedAt(sort: Desc)])
  @@index([resumedAt]) // null = still active block
  @@map("carrier_block_events")
}

/// One row per claim in the call queue. Tracks scheduling, retry count, state.
model CallQueue {
  id            String      @id @default(uuid())
  practiceId    String      @map("practice_id")
  claimId       String      @unique @map("claim_id")
  scheduledFor  DateTime    @map("scheduled_for")
  priority      ClaimPriority @default(NORMAL)
  /// Number of attempts made so far. Hard cap: 3 (enforced before dispatch).
  attempts      Int         @default(0)
  lastAttemptAt DateTime?   @map("last_attempt_at")
  status        QueueStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  claim InsuranceClaim @relation(fields: [claimId], references: [id])

  @@index([practiceId, status])
  @@index([scheduledFor])
  @@index([practiceId, priority, scheduledFor])
  @@map("call_queue")
}

/// Outbound events for practice EMR / PMS connectors (AbelDent, etc.). Worker drains `processedAt IS NULL`.
model EmrSyncOutbox {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now()) @map("created_at")
  practiceId   String    @map("practice_id")
  claimId      String    @map("claim_id")
  eventType    String    @map("event_type")
  payloadJson  Json      @map("payload_json")
  processedAt  DateTime? @map("processed_at")

  @@index([practiceId, createdAt(sort: Desc)])
  @@index([claimId])
  @@index([processedAt])
  @@map("emr_sync_outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXISTING TABLES — Phase 3 eligibility (kept for completeness; primary source
// of truth is migrations/eligibility-schema.sql — these models let Prisma
// Client query them type-safely without re-migrating).
// ─────────────────────────────────────────────────────────────────────────────

enum EligibilityStatus {
  active
  inactive
  unknown

  @@map("eligibility_status")
}

enum CoverageTier {
  preventive
  basic
  major
  ortho

  @@map("coverage_tier")
}

enum ReconciliationFlag {
  within_threshold
  variance_high
  variance_critical
  needs_review

  @@map("reconciliation_flag")
}

model InsurancePlan {
  planId             String    @id @default(uuid()) @map("plan_id")
  patientId          String    @map("patient_id")
  carrier            CarrierId
  planName           String    @map("plan_name")
  groupNumber        String    @map("group_number")
  memberId           String    @map("member_id")
  effectiveDate      DateTime  @map("effective_date") @db.Date
  terminationDate    DateTime? @map("termination_date") @db.Date
  isPrimary          Boolean   @default(true) @map("is_primary")
  telusUnderlyingTpa String?   @map("telus_underlying_tpa")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([carrier])
  @@map("insurance_plans")
}

model EligibilitySnapshot {
  snapshotId                String            @id @default(uuid()) @map("snapshot_id")
  practiceId                String            @map("practice_id")
  patientId                 String            @map("patient_id")
  carrier                   CarrierId
  planId                    String?           @map("plan_id")
  status                    EligibilityStatus @default(unknown)
  verifiedAt                DateTime          @map("verified_at")
  deductibleIndividualMet   Decimal           @default(0) @map("deductible_individual_met") @db.Decimal(10, 2)
  deductibleFamilyMet       Decimal           @default(0) @map("deductible_family_met") @db.Decimal(10, 2)
  annualMaxUsedIndividual   Decimal           @default(0) @map("annual_max_used_individual") @db.Decimal(10, 2)
  annualMaxUsedFamily       Decimal?          @map("annual_max_used_family") @db.Decimal(10, 2)
  planYearStart             DateTime          @map("plan_year_start") @db.Date
  rawCarrierResponse        Json?             @map("raw_carrier_response")
  createdAt                 DateTime          @default(now()) @map("created_at")

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([practiceId, patientId, carrier, verifiedAt(sort: Desc)])
  @@map("eligibility_snapshots")
}

model ReconciliationLog {
  reconciliationId        String             @id @default(uuid()) @map("reconciliation_id")
  claimId                 String             @map("claim_id")
  patientId               String             @map("patient_id")
  estimateId              String?            @map("estimate_id")
  reconciledAt            DateTime           @default(now()) @map("reconciled_at")
  estimatedPatientTotal   Decimal            @map("estimated_patient_total") @db.Decimal(10, 2)
  actualPatientTotal      Decimal            @map("actual_patient_total") @db.Decimal(10, 2)
  variance                Decimal            @db.Decimal(10, 2)
  variancePercent         Decimal            @map("variance_percent") @db.Decimal(6, 2)
  flag                    ReconciliationFlag
  patientBalanceAdjustment Decimal           @map("patient_balance_adjustment") @db.Decimal(10, 2)
  varianceReasons         String[]           @map("variance_reasons")
  requiresHumanReview     Boolean            @default(false) @map("requires_human_review")
  reviewedBy              String?            @map("reviewed_by")
  reviewedAt              DateTime?          @map("reviewed_at")
  reviewNotes             String?            @map("review_notes")
  rawAdjudicationJson     Json               @map("raw_adjudication_json")
  createdAt               DateTime           @default(now()) @map("created_at")

  @@index([patientId, reconciledAt(sort: Desc)])
  @@index([claimId])
  @@map("reconciliation_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// AR Brain roadmap — PMS sync, unified work queue, daily close
// ─────────────────────────────────────────────────────────────────────────────

enum WorkItemType {
  insurance
  patient_ar
  outreach

  @@map("work_item_type")
}

enum WorkItemSource {
  insurance_claim
  patient_balance
  outreach_balance

  @@map("work_item_source")
}

/// Nightly PMS export import audit (Dentrix / AbelDent file drops).
model PmsImportRun {
  id                   String    @id @default(uuid())
  practiceId           String    @map("practice_id")
  pmsSource            String    @map("pms_source")
  status               String    @default("running")
  startedAt            DateTime  @default(now()) @map("started_at")
  completedAt          DateTime? @map("completed_at")
  recordsTotal         Int       @default(0) @map("records_total")
  recordsImported      Int       @default(0) @map("records_imported")
  recordsFailed        Int       @default(0) @map("records_failed")
  recordsSkipped       Int       @default(0) @map("records_skipped")
  sourceRecordCount    Int?      @map("source_record_count")
  sourceBalanceTotal   Decimal?  @map("source_balance_total") @db.Decimal(14, 2)
  importedBalanceTotal Decimal?  @map("imported_balance_total") @db.Decimal(14, 2)
  driftPct             Float?    @map("drift_pct")
  validationPassed     Boolean?  @map("validation_passed")
  errorLog             Json?     @map("error_log")

  @@index([practiceId, startedAt(sort: Desc)])
  @@map("pms_import_runs")
}

/// Unified AR work queue — merged from insurance claims, patient AR, outreach balances.
model WorkItem {
  id               String         @id @default(uuid())
  practiceId       String         @map("practice_id")
  sourceType       WorkItemSource @map("source_type")
  sourceId         String         @map("source_id")
  itemType         WorkItemType   @map("item_type")
  dollarsAtRisk    Decimal        @map("dollars_at_risk") @db.Decimal(12, 2)
  daysOutstanding  Int            @default(0) @map("days_outstanding")
  carrierId        CarrierId?     @map("carrier_id")
  title            String?
  assignedRep      String?        @map("assigned_rep")
  followUpAt       DateTime?      @map("follow_up_at")
  notes            String?
  status           String         @default("open")
  rankScore        Float          @default(0) @map("rank_score")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([practiceId, sourceType, sourceId])
  @@index([practiceId, status, rankScore(sort: Desc)])
  @@index([practiceId, assignedRep])
  @@map("work_items")
}

/// End-of-day AR reconciliation vs PMS / queue totals.
model ArCloseRun {
  id                 String    @id @default(uuid())
  practiceId         String    @map("practice_id")
  closeDate          DateTime  @map("close_date") @db.Date
  queueOpenTotal     Decimal   @map("queue_open_total") @db.Decimal(14, 2)
  paymentsReceived   Decimal   @map("payments_received") @db.Decimal(14, 2)
  pmsLedgerTotal     Decimal?  @map("pms_ledger_total") @db.Decimal(14, 2)
  variancePct        Float     @map("variance_pct")
  validationPassed   Boolean   @map("validation_passed")
  details            Json?
  createdAt          DateTime  @default(now()) @map("created_at")

  @@unique([practiceId, closeDate])
  @@index([practiceId, closeDate(sort: Desc)])
  @@map("ar_close_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 6 — Autonomous learning & implementation loop
// ─────────────────────────────────────────────────────────────────────────────

enum LearningBucket {
  PRODUCT
  ENGINEERING
  OPS
  GROWTH
  COMPLIANCE

  @@map("learning_bucket")
}

enum LearningCandidateStatus {
  RESEARCHED
  RANKED
  IMPLEMENTED
  SKIPPED
  FAILED

  @@map("learning_candidate_status")
}

/// One scheduled learning cycle (Notion pull → research → rank → implement → SMS).
model LearningCycleRun {
  id                String    @id @default(uuid())
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  status            String    @default("running")
  pulledCount       Int       @default(0) @map("pulled_count")
  researchedCount   Int       @default(0) @map("researched_count")
  rankedCount       Int       @default(0) @map("ranked_count")
  implementedCount  Int       @default(0) @map("implemented_count")
  skippedCount      Int       @default(0) @map("skipped_count")
  smsSent           Boolean   @default(false) @map("sms_sent")
  summary           Json?
  error             String?

  candidates LearningCandidate[]

  @@index([startedAt(sort: Desc)])
  @@map("learning_cycle_runs")
}

/// Item processed in a cycle; linked to Notion page.
model LearningCandidate {
  id                   String                  @id @default(uuid())
  cycleRunId           String                  @map("cycle_run_id")
  notionPageId         String                  @map("notion_page_id")
  title                String
  bucket               LearningBucket?
  rankScore            Float?                  @map("rank_score")
  feasibilityScore     Float?                  @map("feasibility_score")
  status               LearningCandidateStatus @default(RESEARCHED)
  researchNotes        Json?                   @map("research_notes")
  implementationResult Json?                   @map("implementation_result")
  createdAt            DateTime                @default(now()) @map("created_at")

  cycleRun LearningCycleRun @relation(fields: [cycleRunId], references: [id], onDelete: Cascade)

  @@unique([cycleRunId, notionPageId])
  @@index([cycleRunId, rankScore(sort: Desc)])
  @@map("learning_candidates")
}

/// One-time token for password reset. Expires after 1 hour.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ─── Platform personas (build brief) ─────────────────────────────────────────

model PlatformUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  userRole     String   @map("user_role")
  practiceId   String?  @map("practice_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userRole])
  @@map("platform_users")
}

model CallEscalation {
  id                 String    @id @default(uuid())
  practiceId         String    @map("practice_id")
  callAttemptId      String?   @map("call_attempt_id")
  claimId            String    @map("claim_id")
  claimRef           String    @map("claim_ref")
  carrierId          CarrierId @map("carrier_id")
  amountClaimedCents Int       @map("amount_claimed_cents")
  reason             String
  status             String    @default("open")
  resolution         String?
  resolvedByStaffId  String?   @map("resolved_by_staff_id")
  resolvedAt         DateTime? @map("resolved_at")
  resolutionNotes    String?   @map("resolution_notes")
  attemptNumber      Int?      @map("attempt_number")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([practiceId, status])
  @@map("call_escalations")
}

model AuditorGrant {
  id            String   @id @default(uuid())
  auditorUserId String   @map("auditor_user_id")
  practiceId    String?  @map("practice_id")
  grantedAt     DateTime @default(now()) @map("granted_at")

  @@unique([auditorUserId, practiceId])
  @@map("auditor_grants")
}

model PlatformAdminPracticeGrant {
  id               String   @id @default(uuid())
  adminUserId      String   @map("admin_user_id")
  practiceId       String   @map("practice_id")
  grantedByOwnerId String   @map("granted_by_owner_id")
  grantedAt        DateTime @default(now()) @map("granted_at")

  @@unique([adminUserId, practiceId])
  @@map("platform_admin_practice_grants")
}

model BreakGlassAuditLog {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  action      String
  reason      String
  performedAt DateTime @default(now()) @map("performed_at")

  @@index([performedAt(sort: Desc)])
  @@map("break_glass_audit_logs")
}

model PmsWritebackLog {
  id                String    @id @default(uuid())
  practiceId        String    @map("practiceId")
  source            String
  claimRef          String    @map("claimRef")
  abeldentPatientId String?   @map("abeldentPatientId")
  payload           Json
  processedAt       DateTime? @map("processedAt")
  processError      String?   @map("processError")
  createdAt         DateTime  @default(now()) @map("createdAt")

  @@index([practiceId, createdAt])
  @@index([claimRef])
  @@index([practiceId, processedAt])
  @@map("PmsWritebackLog")
}

model CdcpReconsiderationCase {
  id                        String   @id @default(uuid())
  practiceId                String   @map("practiceId")
  patientToken              String   @map("patientToken")
  claimRef                  String   @map("claimRef")
  carrierCode               String   @default("cdcp_sunlife") @map("carrierCode")
  procedureCode             String?  @map("procedureCode")
  denialDate                DateTime @map("denialDate")
  status                    String   @default("open")
  exclusionReason           String?  @map("exclusionReason")
  clinicalEvidenceSummary   String?  @map("clinicalEvidenceSummary")
  originalAdjudicatorHint   String?  @map("originalAdjudicatorHint")
  createdAt                 DateTime @default(now()) @map("createdAt")
  updatedAt                 DateTime @updatedAt @map("updatedAt")

  @@unique([practiceId, claimRef])
  @@index([practiceId, denialDate])
  @@index([practiceId, status])
  @@index([patientToken])
  @@map("CdcpReconsiderationCase")
}

model FeeGuideEntry {
  id            String   @id @default(uuid())
  scope         String
  effectiveDate DateTime @map("effectiveDate")
  cdtCode       String   @map("cdtCode")
  feeCad        Float    @map("feeCad")
  source        String?
  notes         String?
  createdAt     DateTime @default(now()) @map("createdAt")

  @@unique([scope, effectiveDate, cdtCode])
  @@index([scope, cdtCode])
  @@map("FeeGuideEntry")
}

