// ─────────────────────────────────────────────────────────────────────────────
// PHI Vault — encrypted persistence layer for PIIVault restart resilience
//
// Each row stores one patientToken → PatientPHI mapping, encrypted with
// AES-256-GCM using PHI_ENCRYPTION_KEY from the secret manager.
// Rows expire at the same time as the in-memory token (TOKEN_TTL_MS, 4 h).
// On server restart, rehydrate() decrypts all live rows into the in-memory
// vault so the queue engine can dispatch without re-importing claims.
//
// NEVER store plaintext PHI here. Ciphertext, IV, and auth tag only.
// ─────────────────────────────────────────────────────────────────────────────

/// Encrypted PHI backing store for in-memory PIIVault restart resilience.
model PhiVaultEntry {
  /// UUID token — same value stored in InsuranceClaim.patientToken.
  token      String   @id
  practiceId String   @map("practice_id")
  /// AES-256-GCM ciphertext of JSON.stringify(PatientPHI), hex-encoded.
  ciphertext String
  /// Hex-encoded 12-byte random IV.
  iv         String
  /// Hex-encoded 16-byte GCM auth tag.
  authTag    String   @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([practiceId])
  @@index([expiresAt])
  @@map("phi_vault_entries")
}

/// Per-practice (or global, when practiceId is null) feature pause state —
/// e.g. auto-pause on hard usage cap (tiers.ts hardStopAtLimit) or carrier-wide
/// suspension. Resume requires manual confirmation unless explicitly disabled.
