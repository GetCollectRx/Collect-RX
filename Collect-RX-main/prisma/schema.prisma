  requestedBy String?                   @map("requested_by")
  completedAt DateTime?                 @map("completed_at")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  proposals CarrierNavigationProposal[]

  @@index([carrierId, status, dueAt])
  @@index([trigger, createdAt(sort: Desc)])
  @@map("carrier_discovery_runs")
}

/// Immutable, platform-wide IVR/navigation knowledge. Only a reviewed snapshot
/// may be used as a call instruction source.
model CarrierNavigationSnapshot {
  id          String    @id @default(uuid())
  carrierId   CarrierId @map("carrier_id")
  version     Int
  navigation  Json
  summary     String
  publishedAt DateTime? @map("published_at")
