# Same image as web; only the start command differs (BullMQ worker).
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y openssl ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

ARG CACHEBUST=20260609a

WORKDIR /app

COPY package.json package-lock.json ./
COPY scripts/ensure-electron-symlink.cjs ./scripts/ensure-electron-symlink.cjs
COPY prisma ./prisma/

RUN npm install --include=dev --ignore-scripts
RUN npx prisma generate

COPY . .
RUN npm run build

CMD ["npm", "run", "worker"]
