# Same image as web; only the start command differs (BullMQ worker).
FROM node:20-slim

RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
COPY scripts/ensure-electron-symlink.cjs ./scripts/ensure-electron-symlink.cjs
COPY prisma ./prisma/

# Do not copy package-lock.json — monorepo lock often drifts; install from package.json only.
RUN npm install
RUN npx prisma generate

COPY . .
RUN npm run build

CMD ["npm", "run", "worker"]
