FROM node:22-slim

RUN apt-get update \
&& apt-get install -y openssl ca-certificates python3 make g++ \
&& rm -rf /var/lib/apt/lists/*

ARG CACHEBUST=20261002a
RUN echo "cachebust: ${CACHEBUST}" > /dev/null

WORKDIR /app

# Production builds use the repository-root workspace lockfile. Keep the
# workspace manifest beside it so npm ci resolves the exact locked graph
# instead of treating the monorepo lock as a standalone app lock.
COPY package.json package-lock.json ./
COPY Collect-RX-main/package.json ./Collect-RX-main/package.json
COPY Collect-RX-main/scripts/ensure-electron-symlink.cjs ./Collect-RX-main/scripts/ensure-electron-symlink.cjs
COPY Collect-RX-main/prisma ./Collect-RX-main/prisma/

RUN npm ci --include=dev --ignore-scripts

WORKDIR /app/Collect-RX-main
RUN npx prisma generate

COPY Collect-RX-main/ ./

RUN npm run build \
&& test -f dist/resources/index.html \
&& test -f dist/resources/dental-insurance-follow-up-canada/index.html \
&& test -f dist/resources/canadian-dental-carriers-follow-up/index.html \
&& test -f dist/resources/cdcp-claims-canada/index.html

EXPOSE 3000

CMD ["sh", "-c", "if [ \"$SERVICE_ROLE\" = \"worker\" ]; then npm run worker; else npm run start; fi"]
