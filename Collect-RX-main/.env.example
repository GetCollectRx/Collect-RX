# ─── CollectRx Backend — Environment Variable Reference ───────────────────────
#
# SECURITY RULES:
#   1. Never commit .env to git — it is in .gitignore
#   2. Never hard-code any secret in source code — always use process.env
#   3. In production, set secrets in Fly.io (`fly secrets set -a collect-rx`) — not in files
#   4. Rotate VAPI_API_KEY and DATABASE_URL immediately if exposed
#   5. Generate VAPI_WEBHOOK_SECRET: openssl rand -hex 32
#
# Copy to .env and fill in real values for local development.
# When you add routes, update this map and the comment block at the top of src/server/index.ts.

# ─── HTTP API map (mounts in src/server/index.ts) ────────────────────────────
#   GET  /health                        minimal probe (no /api prefix)
#   GET  /api/health                    liveness JSON
#   GET  /api/health/ready              DB ping — readiness (Fly / k8s)
#   GET  /api/health/metrics            counters + deployment flags; in production deployment flags are redacted unless you send Authorization: Bearer <HEALTH_METRICS_TOKEN>
#   POST /api/auth/login                cookie session (stricter rate limit)
#   …/api/billing/*                     Stripe customer portal / practice subscription
#   …/api/stripe/*                      Connect onboarding (raw webhook: POST /api/stripe/webhook)
#   …/api/insurance/*                   claims, queue, PATCH servicedAt, confirm-payment, CSV import,
#                                       POST …/queue/trigger/:claimId (manual dial)
#   …/api/calls/*                       call attempts / scheduling
#   …/api/carriers/*                    GET …/health, POST …/:id/unblock after CARRIER_BLOCK
#   …/api/analytics/*                   collection-rate, funnel, carrier-performance, etc.
#   …/api/telemetry/*                   product usage SDK (page time, clicks, funnels) — optional ClickHouse
#   …/api/eligibility/*                 estimate, status (DB snapshot), reconcile (+ audit log)
#   GET  /api/queue/priority-scores     multi-factor ranking (?practiceId= required)
#   POST /api/webhooks/vapi             Vapi call.ended (raw body + x-vapi-signature)
#   POST /api/webhooks/sendgrid         SendGrid events (Ed25519 key) — wire in SendGrid UI
#   POST /api/twilio/sms                inbound SMS (signature; set TWILIO_SMS_INBOUND_URL)
#   AbelDent Windows agent: COLLECTRX_API_URL + COLLECTRX_API_TOKEN (RAILWAY_* accepted as deprecated aliases; see below).

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Dev API target: `local` = Express on PORT + Vite proxy to 127.0.0.1 (default).
# `remote` = Vite only; /api proxied to production Fly app (collect-rx.fly.dev).
DEV_API_TARGET=local
# Uncomment to point `npm run dev` at production instead of your local API —
# skips starting Express and talks to collect-rx.fly.dev. Everything you set
# up locally (Postgres, migrations, seed data) is ignored while this is on:
# DEV_API_TARGET=remote
# When DEV_API_TARGET=remote, optional API host (default https://collect-rx.fly.dev):
# DEV_API_ORIGIN=https://collect-rx.fly.dev
# Optional: preferred Vite port (default 5173). `npm run dev` frees stale CollectRx listeners,
# picks free ports if these are taken, and sets API_PORT + VITE_DEV_SERVER_PORT for the proxy.
# VITE_PORT=5173
# Vite dev proxy: forwards /api → 127.0.0.1:API_PORT (if set), else PORT, else 3000.
# Use when PORT is reserved for something else but the CollectRx API runs on another port.
# API_PORT=3000
NODE_ENV=development   # Set to "production" on Fly.io
# Trust X-Forwarded-For (1 hop) for req.ip + rate limiting. Set explicitly if not using production auto-enable.
# TRUST_PROXY=1

# ─── Where the browser / Electron send /api (fixes HTML instead of JSON) ─────
# resolveApiUrl (src/lib/resolveApiUrl.ts): Electron COLLECTRX_API_ORIGIN → <meta crx-public-api-origin>
#   (from PUBLIC_API_BASE_URL on the API when it serves dist/, or VITE_API_ORIGIN at Vite build) → VITE_API_ORIGIN
#   → production fallback for collectrx.ca hostnames (see src/lib/resolveApiUrl.ts) → same-origin /api.
#
# Local — API on this machine (PORT / API_PORT):
#   • Browser + `npm run dev` (Vite): leave VITE_API_ORIGIN unset so /api is proxied to 127.0.0.1:API_PORT|PORT.
#   • If VITE_API_ORIGIN is set to a remote URL, dev on localhost still uses the Vite proxy (same-site cookie).
#     To force cross-origin calls in dev (advanced / CORS debugging), set VITE_DEV_ALLOW_REMOTE_API=true.
# VITE_DEV_ALLOW_REMOTE_API=true
#   • Electron: set COLLECTRX_API_ORIGIN to the same host as Express, e.g. http://127.0.0.1:3000 (must match PORT).
# Local UI against hosted API (Fly — no local Express):
#   • VITE_API_ORIGIN=https://collect-rx.fly.dev
#   • COLLECTRX_API_ORIGIN=https://collect-rx.fly.dev
#   • ALLOWED_ORIGINS on the API must list every site origin that calls the API (apex and www are separate).
#   • If the SPA origin and API origin differ (e.g. www vs the Fly app), set on the API server:
# AUTH_COOKIE_CROSS_SITE=true
#     so the session cookie uses SameSite=None; Secure (required for credentialed cross-origin fetch).
#
# Production — SPA on www.collectrx.ca (static) while API is on Fly:
# The app defaults /api to https://collect-rx.fly.dev when the page host is collectrx.ca (see src/lib/resolveApiUrl.ts).
# Override if your API URL differs: set VITE_API_ORIGIN at build time or PUBLIC_API_BASE_URL on the Express host.
# VITE_API_ORIGIN=https://collect-rx.fly.dev
# COLLECTRX_API_ORIGIN=https://collect-rx.fly.dev
# PUBLIC_API_BASE_URL=https://collect-rx.fly.dev

# P6-01: JSON access logs to stdout (off if LOG_JSON=0; default on when NODE_ENV=production)
# LOG_JSON=1
# Verbose audit samples in non-production (legacy logger path in src/logger.js)
# EMIT_AUDIT_SAMPLE=true
# P6-02: Sentry (optional — server + build-time client DSN)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=   # set explicitly for Sentry release tagging (Fly does not inject a commit SHA)

# Vite / browser (optional — see "Where the browser / Electron send /api" above)
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# ─── Startup scan (runs when app/server launches — emails on failure) ───────
# Server: on by default when NODE_ENV=production. Electron: on unless set to 0.
# STARTUP_HEALTH_SCAN_ENABLED=1
# STARTUP_ALERT_EMAIL_TO=khalid@collectrx.ca
# STARTUP_ALERT_COOLDOWN_MINUTES=30
# Requires SENDGRID_API_KEY + SENDGRID_FROM_EMAIL for alert emails.

# ─── Ops alerts (impact + suggested fixes — see docs/operations/OPS-ALERTS.md) ─
# Master switch: when 1, failures from diagnose/smoke/monitor can notify you.
# OPS_ALERTS_ENABLED=1
# OPS_ALERTS_ON_DIAGNOSE=1       # npm run diagnose -- --alert (or auto with this set)
# OPS_ALERTS_ON_SMOKE_FAIL=1     # npm run smoke:live sends alert on failure
# OPS_MONITOR_ENABLED=1          # in-process checks every 5m (DB, 5xx rate, EMR outbox)
# OPS_MONITOR_INTERVAL_MS=300000
# OPS_ALERT_COOLDOWN_MINUTES=60  # suppress repeat alerts for same issue
# OPS_ALERT_EMAIL_TO=you@example.com,oncall@example.com
# OPS_ALERT_EMAIL_FROM_NAME=CollectRx Ops
# OPS_ALERT_WEBHOOK_URL=         # Slack incoming webhook JSON
# OPS_ALERT_5XX_MIN_REQUESTS=20
# Practice gate alerts (SMS/email to owner/manager when a blocking gate opens):
# PRACTICE_GATE_ALERTS_ENABLED=1   # also enabled when OPS_ALERTS_ENABLED=1
# PRACTICE_GATE_ALERT_COOLDOWN_MINUTES=30
# PRACTICE_GATE_EMAIL_TO=         # optional override; default = owner + manager emails in DB
# PRACTICE_GATE_SMS_TO=            # optional override; default = ALERT_SMS_TO
# PRACTICE_ALERT_EMAIL_FROM_NAME=CollectRx
# OPS_ALERT_5XX_RATIO=0.1
# OPS_ALERT_EMR_MIN_FAILED=3

# ─── Phase 7 pilot instrumentation ───────────────────────────────────────────
# Weekly email to practice owner (Monday 08:00 ET) + assumption dashboard data
# PILOT_WEEKLY_REPORT_ENABLED=1
# PILOT_PRACTICE_IDS=uuid-of-pilot-practice
# PILOT_START_DATE=2026-07-01
# PILOT_REPORT_CC=khalidegeh97@gmail.com
# PILOT_SUBSCRIPTION_COST_CAD=499
# Carrier block SMS (Phase 7: immediate alert to Khalid):
# ALERT_SMS_TO=+16135551234
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM_NUMBER=

# Desktop connector health sweep (stale heartbeat / sync failure → ops alert):
# CONNECTOR_MONITOR_ENABLED=1
# CONNECTOR_MONITOR_CRON=*/15 * * * *

# GitHub Releases API (optional — powers GET /api/desktop/releases download page):
# Fly / server: private GitHub release downloads (any one of these names):
# GITHUB_RELEASES_TOKEN=ghp_...
# COLLECTRX=ghp_...

# ─── Database (required) ─────────────────────────────────────────────────────
# Use any PostgreSQL you already run (Homebrew, Postgres.app, RDS, Neon, etc.).
#
# ⚠ PORT MATTERS — pick ONE of these two, don't guess:
#   - Using `docker compose up -d` from the repo root (see docker-compose.yml)?
#     → port 5433 (chosen specifically to avoid clashing with a native install).
#   - Using a Postgres you installed yourself (apt/Homebrew/Postgres.app, already
#     running before you read this file)? → it's almost certainly port 5432, the
#     Postgres default. The line below defaults to 5433 (the Docker path) — if you
#     didn't run `docker compose up -d`, change 5433 to 5432 or migrate/dev will
#     fail to connect with a generic "connection refused"/timeout error that gives
#     no hint the port is the problem.
#
# Fly Postgres from your Mac: run `fly proxy 5432 -a <pg-app>` and connect to localhost,
# or use `fly postgres connect`. Hosts ending in .flycast/.internal only resolve inside
# the Fly private network. Do not copy placeholder user:password like USER:PASSWORD.
#
# TLS (encryption in transit to Postgres): In production, DATABASE_URL MUST require TLS —
# e.g. append ?sslmode=require. The server refuses to
# start without it when NODE_ENV=production. See docs/operations/DATA-ENCRYPTION.md.
#
# Local default (repo-root `docker compose up -d`):
# Docker Postgres from repo root: `docker compose up -d` (published on host port 5433; see docker-compose.yml)
DATABASE_URL=postgresql://collectrx:collectrx_local_dev_only@localhost:5433/collectrx
# Native/local Postgres instead of Docker — same creds, just port 5432:
# DATABASE_URL=postgresql://collectrx:collectrx_local_dev_only@localhost:5432/collectrx
# If you use another Postgres, replace user/password/db (do not leave placeholder text):
# DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb
# Staging/production: set in the host — never commit real secrets.
# Hosted Postgres (Neon, Supabase, etc.): use the vendor’s “transaction” / Prisma pooler URL if they offer one;
# avoid mixing pgbouncer transaction mode with Prisma settings that expect session mode unless docs say otherwise.
# Migrations: from monorepo root `collectrx-platform/`: npm run db:migrate:collectrx
#   Or from here: npm run db:migrate:collectrx  (same as db:migrate)

# ─── PHI at rest (AES-256-GCM) ────────────────────────────────────────────────
# Application-layer encryption for fields you wire through src/server/crypto/phiAtRest.ts.
# PHI_ENCRYPTION_KEY: exactly 32 bytes — use 64 hex chars (openssl rand -hex 32) OR base64 of 32 raw bytes.
#   Load from AWS KMS / Azure Key Vault / GCP KMS or your host secret manager in production — never commit.
# PHI_ENCRYPTION_AT_REST=1 — in NODE_ENV=production, server refuses to start unless PHI_ENCRYPTION_KEY is valid.
# The persisted PHI vault is also enabled in production and always requires this
# key before the server listens; a failed vault rehydration prevents startup.
# PHI_ENCRYPTION_AT_REST=0
# Encrypted pre-call triage credential enrollment always requires PHI_ENCRYPTION_KEY,
# even when PHI_ENCRYPTION_AT_REST remains off. Configure the key before enrollment;
# credential plaintext is never stored or returned by an HTTP API.
#
# PHI vault token retention. Tokens must outlive the claim lifecycle (first call
# at day 30+, automated recovery to day 90) — a short TTL strands claims whose
# token expires before their call. Entries are AES-256-GCM encrypted at rest.
# PHI_VAULT_TTL_DAYS=120
# Max active tokens across all practices; tokenize() throws at the cap.
# PHI_VAULT_MAX_TOKENS=100000

# PostgreSQL RLS (defense-in-depth tenant isolation). Set to 0 only for local debugging.
# COLLECTRX_RLS_ENABLED=1
#
# Optional in-process HTTPS (strict TLS 1.2–1.3, tight ciphers). Leave unset on Fly (proxy terminates TLS).
# TLS_KEY_PATH=/path/to/privkey.pem
# TLS_CERT_PATH=/path/to/fullchain.pem

# JWT signing secret for practice session cookies (required in production)
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_32

# ─── Demo / seed (multi-tenant — one generic test practice) ─────────────────
# SEED_PRACTICE_NAME=CollectRx Demo Practice
# SEED_PRACTICE_EMAIL=demo@collectrx-test.local
# SEED_PRACTICE_DISPLAY_NAME=Demo Owner
# SEED_PRACTICE_PASSWORD=your-long-random-password   # required for npm run demo:seed; min 8 chars

# Platform developer login (PHI-free ops): POST /api/auth/login/platform-dev
# Use a long random password; never share with practice staff. Optional bcrypt hash instead of plain text:
# PLATFORM_DEV_PASSWORD=your_dev_only_secret
# PLATFORM_DEV_PASSWORD_HASH=   # bcrypt hash of the same password (production)
# When the SPA and API are on different sites (e.g. www vs the Fly app), set on the API:
# AUTH_COOKIE_CROSS_SITE=true
# so `crx_access` uses SameSite=None; Secure. CORS must list the SPA origin in ALLOWED_ORIGINS.
# Stripe Connect onboard refresh/complete URLs include ?v= HMAC; defaults to JWT_SECRET. Set a dedicated value
# if you rotate JWT_SECRET and must not break in-flight Stripe AccountLink redirects (openssl rand -hex 32).
# STRIPE_ONBOARD_RETURN_SECRET=

# Patient-facing links in reminder messages (no trailing slash). In production set to your deployed app URL.
PUBLIC_APP_URL=http://localhost:5173
# P4-02: public origin of the **API** (no trailing slash) for email unsubscribe links and SPA meta injection.
# If unset, server code may default to http://localhost:3000 in dev. In production set to the host that serves /api.
# When the API also serves dist/index.html, set PUBLIC_API_BASE_URL to this same origin so <meta name="crx-public-api-origin">
# points the UI at JSON for /api (split CDN + API deploys).
# PUBLIC_API_BASE_URL=https://collect-rx.fly.dev
# P4-02: optional; defaults to JWT_SECRET. Recommended separate value in production (openssl rand -hex 32).
# EMAIL_UNSUBSCRIBE_SECRET=
# Optional: shown in collection messages; otherwise copy says "our office"
# PRACTICE_BILLING_PHONE=+1-555-555-0100

# ─── Front desk takeover (optional) ───────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ─── Vapi ─────────────────────────────────────────────────────────────────────
# VAPI_API_KEY: dashboard.vapi.ai → API Keys
# TREAT LIKE A PASSWORD — rotate immediately if ever exposed
VAPI_API_KEY=your_vapi_api_key_id_here

# VAPI_SQUAD_ID — dashboard → Squads → ID (required for outbound squad calls from src/vapi/client.ts)
# VAPI_SQUAD_ID=

# Optional separate squad for pre-visit eligibility / CDCP predet calls (falls back to VAPI_SQUAD_ID)
# VAPI_PREVISIT_SQUAD_ID=

# VAPI_PHONE_NUMBER_ID: dashboard.vapi.ai → Phone Numbers → your number → ID
VAPI_PHONE_NUMBER_ID=your_phone_number_uuid_here

# Optional default practice UUID embedded in Vapi metadata when PRACTICE_ID is not passed per-call
# PRACTICE_ID=

# VAPI_WEBHOOK_SECRET (must match what Vapi sends in x-vapi-secret; see below)
# Vapi no longer always shows a simple “Server secret” on the phone number screen.
# Current approach: Custom Credentials (Dashboard) → create credential for legacy
# X-Vapi-Secret behavior (Bearer, header "X-Vapi-Secret", no Bearer prefix), OR leave
# unset in dev (verification skipped; see src/middleware/security.js).
# Docs: https://docs.vapi.ai/server-url/server-authentication
# You choose the token: e.g. run `openssl rand -hex 32` and paste the SAME value here
# and in Vapi for that credential.
VAPI_WEBHOOK_SECRET=your_webhook_signing_token_here
# HTTP deadline for every Vapi API request (ms). A hung connection would otherwise
# freeze the queue-engine tick permanently. Default 30000, floor 5000.
# VAPI_HTTP_TIMEOUT_MS=30000
# P4-05: Vapi server URL in dashboard → https://YOUR_API_HOST/api/webhooks/vapi (raw body + HMAC; same secret as above).
# Optional: if you rely on server `assistant-request`, set a saved assistant to return from the webhook.
# VAPI_DEFAULT_ASSISTANT_ID=
# Pre-visit squad JSON template: vapi-previsit-config.json (deploy to VAPI dashboard)

# ─── Anthropic API (explicit opt-in only — NOT for Cursor, NOT for ~/.zshrc) ──
# Voice calls bill VAPI wallet (Haiku). Direct Anthropic console billing comes from:
#   - COLLECTRX_ANTHROPIC_EVAL=1 + an explicit eval or carrier-lesson extraction run
#   - Claude Code CLI / loop_runner when ANTHROPIC_API_KEY is in your shell (avoid)
# NEVER export ANTHROPIC_API_KEY in ~/.zshrc — it caused ~$56/week Opus spend.
# ANTHROPIC_API_KEY=sk-ant-...   # host secret only; never commit or export globally
# COLLECTRX_ANTHROPIC_EVAL=0       # default off; also gates carrier lesson extraction
# Free validation: npm test && npm run agents

# ─── IVR research / kill-test (scripts/ivr-research/) ───────────────────────
# Uses VAPI_API_KEY + VAPI_PHONE_NUMBER_ID from above.
# If RESEARCH_* / VAPI_SQUAD_ID are unset, scripts auto-discover your Vapi squad/assistant.
# Optional overrides:
# RESEARCH_VAPI_ASSISTANT_ID=
# RESEARCH_VAPI_PHONE_NUMBER_ID=
# VAPI_SQUAD_ID=                    # same squad as production dispatch (recommended to set explicitly)
# RESEARCH_DISCLOSURE_NAME=Northgate Dental, internal test line

# ─── Carrier IVR discovery (operator-only; disabled by default) ──────────────
# Creates monthly/issue work records and human-reviewed navigation proposals.
# It NEVER schedules or places discovery calls or clears CARRIER_BLOCK.
# Explicit non-block IVR failures may create PHI-safe proposals. Every proposal
# requires a separate human approval before its navigation snapshot is published.
# See docs/operations/CARRIER-IVR-DISCOVERY.md.
# COLLECTRX_CARRIER_DISCOVERY_ENABLED=0

# ─── Canada Life providerConnect (electronic pre-visit) ───────────────────────
# PROVIDER_CONNECT_PROVIDER_ID=
# PROVIDER_CONNECT_API_KEY=
# PROVIDER_CONNECT_BASE_URL=https://providerconnect.canadalife.com/api/v1

# ─── ITRANS 2 / CDAnet Tx23 (TELUS electronic pre-visit) ────────────────────
# ITRANS2_ENDPOINT=https://your-cdanet-gateway.example.com
# ITRANS2_SITE_ID=
# ITRANS2_SOFTWARE_ID=
# ITRANS2_CLIENT_CERT_PATH=
# ITRANS2_CLIENT_CERT_PEM=
# ITRANS2_TEST_MODE=1
# ITRANS2_TEST_PASSED=0
# ITRANS2_LIVE=0

# ─── Autonomous Agent Runtime ─────────────────────────────────────────────────
# Secret for POST /api/agent-runs — set this as a Fly secret and in each scheduled task env
# AGENT_RUNTIME_SECRET=                 # generate: openssl rand -hex 32
# SMTP_URL=                             # e.g. smtps://user:pass@smtp.sendgrid.net:465 — for CRITICAL escalation emails

# ─── SendGrid (P4-01) & Twilio (P4-03) & Slack notifications ────────────────────
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=notifications@collectrx.ca
# SENDGRID_FROM_NAME=CollectRx
# P4-01: SendGrid → Settings → Webhooks → Event Webhook: paste signing key (Ed25519) for /api/webhooks/sendgrid
# Required in production — unsigned requests return 401.
# SENDGRID_EVENT_WEBHOOK_VERIFICATION_KEY=
# SendGrid Inbound Parse → POST /api/webhooks/sendgrid-inbound (reply intelligence)
# Phase 5 & 6 notifications (CDCP updates, learning cycles):
# ALERT_EMAIL_TO=practice-owner@example.com    # alert emails for learning cycles
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK  # ops notifications (Slack block-kit)
# MARKETING_ALERT_EMAIL=          # hot lead email alerts
# SLACK_MARKETING_WEBHOOK_URL=      # Slack block-kit hot lead alerts
# GOOGLE_PLACES_API_KEY=          # prospect harvester (Google Places Text Search)
# Automated prospect harvesting from active campaigns with harvest queries
# PROSPECT_HARVEST_ENABLED=1       # enable automated scheduling (default off)
# PROSPECT_HARVEST_CRON=0 2 * * *  # daily at 2 AM ET (default)
# MARKETING_DEMO_LINK=https://www.collectrx.ca/#early-access
# MARKETING_LOGO_URL=https://www.collectrx.ca/og-image.png
# MARKETING_SITE_URL=https://www.collectrx.ca
# MARKETING_AUTO_REPLY_POSITIVE=true   # auto-send demo reply on positive inbound (set false to suggest only)
# MARKETING_SOCIAL_PROOF_ENABLED=false # set true when you have a permitted named reference
# MARKETING_SOCIAL_PROOF_LINE=         # one sentence, appears in email 4 when enabled
# VAPI_SALES_ASSISTANT_ID=        # Vapi assistant for partnership qualification calls
# VAPI_PHONE_NUMBER_ID=           # Vapi phone number resource id (outbound)
# MARKETING_TICK_MS=3600000       # BullMQ marketing sequence interval (default 1h)
# MARKETING_CRON=0 * * * *        # in-process tick when REDIS_URL unset
# MARKETING_LOOP_ENABLED=1        # set 0 to disable automated cadence
# MARKETING_LEARNING_ENABLED=1    # weekly self-tuning harvest scores (default on)
# MARKETING_LEARNING_CRON=0 7 * * 1   # Monday 07:00 — adjusts weights from closed_won vs closed_lost
# MARKETING_DEMO_WEBHOOK_SECRET=     # Calendly/Cal.com/generic demo booking → POST /api/webhooks/demo-booking
# DNCL_PHONE_LIST_PATH=              # optional local DNCL list (one normalized phone per line)
# DNCL_CHECK_URL=                    # optional HTTP POST { phone } → { listed: boolean }
# DNCL_CHECK_API_KEY=                # bearer token for DNCL_CHECK_URL
# DNCL_STRICT=false                  # dev: skip DNCL requirement; prod default blocks calls without checker
# HUBSPOT_ACCESS_TOKEN=              # CRM sync on stage changes
# HUBSPOT_PIPELINE_ID=default        # HubSpot deal pipeline
# HUBSPOT_DEAL_STAGE_MAP=            # JSON map ProspectStage → HubSpot dealstage id
# MARKETING_PRACTICE_TEMP_PASSWORD=  # optional fixed temp password on closed-won practice handoff
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# P4-03: exact public URL Twilio uses for "A message comes in" (must match signature validation)
# TWILIO_SMS_INBOUND_URL=https://collect-rx.fly.dev/api/twilio/sms

# ─── CORS ─────────────────────────────────────────────────────────────────────
# One env var: comma-separated browser origins (no spaces, no trailing slash).
# Prefer the variable name `ALLOWED_ORIGINS` (some host UIs label the row "Allowed Origins" — same value).
# The server mirrors https://collectrx.ca ↔ https://www.collectrx.ca when either appears alone
# (see src/server/corsAllowedOrigins.ts). Each browser tab still sends one `Origin`; CORS echoes that one.
# Single public site origin is fine — apex is auto-added for collectrx.ca:
# ALLOWED_ORIGINS=https://www.collectrx.ca,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173
# Local only: relax strict rate limits for 127.0.0.1 (see src/middleware/security.js). Never set in production.
# ALLOW_STRICT_LIMIT_LOCALHOST_BYPASS=true

# ─── Practice identity (multi-tenant SaaS) ───────────────────────────────────
# CollectRx is a multi-tenant platform. Each practice's name, billing phone, fax,
# address, NPI, and carrier credentials are stored in PostgreSQL (`Practice` row +
# Admin → Practice identity). They are injected into Vapi call variables at dispatch
# time — never hardcoded here for production.
#
# Demo / local seed (creates one generic test tenant — not a real practice):
# SEED_PRACTICE_NAME=CollectRx Demo Practice
# SEED_PRACTICE_EMAIL=demo@collectrx-test.local
# SEED_PRACTICE_DISPLAY_NAME=Demo Owner
# SEED_PRACTICE_PASSWORD=your-long-random-password   # required; min 8 chars; no default
#
# Optional script-only overrides for manual Vapi smoke tests (`node test-call.js`):
# VAPI_PRACTICE_NAME=CollectRx Demo Practice
# VAPI_PRACTICE_PHONE=555-0100
# VAPI_PRACTICE_ADDRESS=123 Demo Street, Ottawa ON
# VAPI_PROVIDER_NUMBER=123456
#
# Legacy global PRACTICE_* vars are removed — do not set PRACTICE_NAME in production.

# ─── Queue Cost Controls ──────────────────────────────────────────────────────
QUEUE_MIN_DAYS_OUTSTANDING=14     # Don't call claims under 14 days old
QUEUE_MIN_CLAIM_VALUE=100         # Don't call claims under $100
QUEUE_MAX_ATTEMPTS_BEFORE_REVIEW=3  # Escalate to human after 3 failed attempts
QUEUE_MAX_CALLS_PER_RUN=20        # Cap calls per run to control costs

# ─── Escalation Alerts ────────────────────────────────────────────────────────
# Webhook JSON is de-identified (IDs + reason code only) so Slack/Teams without a BAA does not receive PHI.
# Must be https:// to prevent SSRF
ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# Front desk — immediate Twilio SMS + optional voice (runs before Slack webhook).
# E.164, comma-separated for multiple handsets. Requires TWILIO_* + TWILIO_FROM_NUMBER.
# Example main line: ESCALATION_STAFF_PHONE=+16138372121
# ESCALATION_STAFF_PHONE=
# Voice: urgent (default) = ring desk on urgent escalations only; all = every escalation; never = SMS only
# ESCALATION_STAFF_VOICE_RING=urgent

# ─── Testing Only ─────────────────────────────────────────────────────────────
# When set, ALL calls go to this number — not real insurance carriers.
# DELETE (do not blank out) this variable before going live.
# TEST_PHONE_OVERRIDE=6135018951

# Required for `npm run db:seed` — no default (avoid weak production seeds).
# SEED_PRACTICE_PASSWORD=your-long-random-practice-password

# ─── Guardrails Audit Sidecar (Phase 5: post-call semantic audit) ──────────────
# NVIDIA NeMo Guardrails sidecar service for transcript auditing.
# If not set, guardrails audits are skipped (but don't block anything).
#
# SIDECAR_URL — HTTP endpoint of the Python audit-sidecar service (no trailing slash)
# SIDECAR_URL=http://localhost:8000
#
# SIDECAR_SHARED_SECRET — bearer token for sidecar calls (generate: openssl rand -hex 32)
# SIDECAR_SHARED_SECRET=your-sidecar-secret

# ─── Deployment / public URLs ─────────────────────────────────────────────────
# Never commit real database URLs with passwords. Use `fly secrets set`.
#
# SERVER_URL — origin of this API (no trailing slash). Stripe Connect return URLs, webhook base hints.
# SERVER_URL=http://localhost:3000
#
# FRONTEND_URL — SPA origin for Checkout / Billing Portal return URLs (billing.ts falls back to PUBLIC_APP_URL).
# FRONTEND_URL=http://localhost:5173
#
# ALLOWED_ORIGINS — comma-separated CORS origins (apex vs www are different Origins; include both in production).
# ALLOWED_ORIGINS=https://www.collectrx.ca,http://localhost:5173,http://127.0.0.1:5173

# ─── AbelDent desktop sync (Windows SQL Server → API; optional on dev Mac) ───
# Discovery: npm run abeldent:discover -- --server "localhost\\SQLEXPRESS" --database AbelDent
# Then copy schema-map.example.json → schema-map.json and run abeldent:validate-queries.
# ABELDENT_SERVER=(local)\\ABELDENT
# ABELDENT_DATABASE=AbelDent
# Path to schema map JSON (desktop agent also accepts SCHEMA_MAP_PATH)
# ABELDENT_SCHEMA_MAP=./schema-map.json
# SCHEMA_MAP_PATH=./schema-map.json
# API the Windows service POSTs to (no trailing slash)
# RAILWAY_API_URL=            # deprecated alias for COLLECTRX_API_URL (still read; prefer COLLECTRX_API_URL)
# RAILWAY_API_TOKEN=          # deprecated alias for COLLECTRX_API_TOKEN (still read; prefer COLLECTRX_API_TOKEN)
# ABELDENT_PRACTICE_ID=        # practice UUID for multi-tenant uploads
# SYNC_INTERVAL_MINUTES=15     # poll / push cadence for desktop/services/abeldent-sync.js
# ABELDENT_MIN_DAYS=14         # min claim age before syncing as candidate
# ABELDENT_MIN_DAYS_BALANCE=7  # min age for balance-led sync
# Override discovered patient ledger table name if your schema differs
# ABELDENT_PATIENT_LEDGER_TABLE=

# ─── Electron desktop (packaged app) ──────────────────────────────────────────
# Dev: `electron/main.js` loads repo-root `.env` so `COLLECTRX_API_ORIGIN` applies (no Vite rebuild).
# Packaged: set `COLLECTRX_API_ORIGIN` in the OS environment, or put one line (https://…, no trailing slash) in:
#   macOS: ~/Library/Application Support/dental-ar-system/api-origin.txt
#   (same folder as `dashboard-url.txt` — see COLLECTRX_DASHBOARD_URL below)
# Use your **Express /api** origin (e.g. https://collect-rx.fly.dev), not https://www.collectrx.ca (static SPA has no JSON /api).
# If the dashboard is remote https, do not leave `http://127.0.0.1:3000` here — mixed content blocks API calls (main strips loopback in that case).
# COLLECTRX_API_ORIGIN=https://collect-rx.fly.dev
#
# Packaged CollectRx does NOT ship your repo `.env`. The window loads a hosted URL (Fly, etc.).
# If you see a host 404 page, the dashboard URL is wrong or nothing is deployed there.
#
# Set the real public URL using either:
#   • macOS: one line in ~/Library/Application Support/dental-ar-system/dashboard-url.txt
#     (same value as your live app, e.g. https://collect-rx.fly.dev — then restart the app)
#   • Advanced: launch with COLLECTRX_DASHBOARD_URL=https://...
# The fallback in `electron/main.js` defaults to https://www.collectrx.ca when unset.
# COLLECTRX_DASHBOARD_URL=https://collect-rx.fly.dev
# First path Electron opens: default /login when the dashboard URL path is / (marketing is /; practice login is /login).
# COLLECTRX_DASHBOARD_START_PATH=/login
# desktop/main.js (legacy): COLLECTRX_FRONTEND_URL — same idea as dashboard URL for some builds
# COLLECTRX_FRONTEND_URL=

# ─── Phase 8: background jobs (BullMQ + Redis) ────────────────────────────────
# If set, the API registers repeatable jobs in Redis; run a separate worker with the same env:
#   npm run worker
# Worker process: DATABASE_URL + REDIS_URL required. Rules tick runs EMR outbox drain + priority sync + balances.
# If REDIS_URL is unset, rules + reminders run in-process on the API only (dev default).
# When set, the API also uses Redis for express-rate-limit counters (shared across multiple API replicas).
# Local (docker compose redis service): redis://127.0.0.1:6379
# REDIS_URL=redis://127.0.0.1:6379
# Local dev with `npm run dev` + `npm run worker`: worker health is on PORT+1 (3001), API on 3000.
# WORKER_HEALTH_PORT=3001
# REDIS_URL=redis://default:password@host:port
# Optional: on secondary API replicas, set to 1 or true to skip registering Bull repeatables (see docs/operations/PHASE8-BACKGROUND.md)
# DISABLE_SCHEDULER=1
# Daily reminder cron for REMINDER_CYCLE job (node-cron syntax). Default 09:00 server local time.
# REMINDER_CRON=0 9 * * *
# Global kill switch for the DATA_RETENTION purge job (src/server/jobs/dataRetentionJob.ts). Off by
# default even when set — also requires settings.retention.purgeEnabled=true per practice. Validate
# in staging against a real database before enabling in production; this job ships untested against
# a live Postgres (see the file header).
# DATA_RETENTION_ENABLED=1
# Stagger between pending call_queue rows after each priority sync (ms). Default 60000.
# PRIORITY_QUEUE_SLOT_MS=60000
#
# Ops: GET /api/health/metrics — http, vapi, emrOutbox, uptime. In NODE_ENV=production, `deployment` booleans are omitted unless you set HEALTH_METRICS_TOKEN and pass Authorization: Bearer <same value>.
# HEALTH_METRICS_TOKEN=
#
# EMR_SYNC_WEBHOOK_URL must be https in production and must not target loopback, RFC1918, or cloud metadata hosts (see src/server/emrWebhookUrl.ts).
#
# Vapi call.ended: prefer structured end-of-call on `metadata.collectrx` or `analysis.collectrx`:
#   { "schemaVersion": 1, "callOutcome": "RESOLVED", "claimStatus": "APPROVED_PENDING_PAYMENT", "outcomeDetail": "…", "carrierBlockDetected": false }
#
# Insurance claims: run `npx prisma migrate deploy` after pull — adds `serviced_at` + `APPROVED_PENDING_PAYMENT`
# on `insurance_claims` / `claim_status`. Backfill `serviced_at` from your PMS for accurate appeal deadlines.
# REST: PATCH /api/insurance/claims/:id (servicedAt), POST /api/insurance/claims/:id/confirm-payment (practice payment → RESOLVED + EMR outbox).
#
# ─── EMR sync outbox (claim RESOLVED → practice PMS / AbelDent bridge) ─────────
# Rows are written to `emr_sync_outbox` from Vapi (CLAIM_RESOLVED) and confirm-payment (PAYMENT_CONFIRMED).
# Each rules-engine tick (in-process every 60s or BullMQ RULES_TICK) drains a batch:
#   • Production: set EMR_SYNC_WEBHOOK_URL to your HTTPS receiver; 2xx marks the row processed (retries on failure).
#   • Optional EMR_SYNC_WEBHOOK_SECRET — sent as Authorization: Bearer …
#   • Local dev without a bridge: EMR_OUTBOX_DEV_ACK=1 clears the queue with logs only (do not use in production).
#   • EMR_OUTBOX_BATCH_SIZE=20 — max rows attempted per tick (1–100).
# EMR_SYNC_WEBHOOK_URL=
# EMR_SYNC_WEBHOOK_SECRET=
# EMR_OUTBOX_DEV_ACK=0
# EMR_OUTBOX_BATCH_SIZE=20

# ─── Stripe (Connect + Billing + webhooks) ───────────────────────────────────
# Production: set STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET as Fly secrets (never commit real keys).
# One webhook endpoint receives Connect events AND platform subscription events:
#   https://YOUR_API_ORIGIN/api/stripe/webhook
# Enable at least: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted,
# account.updated, payment_intent.succeeded (Connect emits these — patient pay is credited from checkout.session.completed).
#
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Platform subscription (practice pays CollectRx) — the sellable catalog is exactly
# the paid tiers in src/billing/tiers.ts (core $799 / growth $1,999 / scale $2,499).
# Create one recurring Price per tier in the Stripe Dashboard and set:
# STRIPE_PRICE_CORE=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...
# Optional metered overage prices (Core/Growth $0.25/min, Scale $0.20/min):
# STRIPE_OVERAGE_PRICE_CORE=price_...
# STRIPE_OVERAGE_PRICE_GROWTH=price_...
# STRIPE_OVERAGE_PRICE_SCALE=price_...
# SUBSCRIPTION_DEFAULT_PLAN_ID=core                    # which tier Checkout uses when none is chosen
#
# Legacy aliases (still honored, mapped onto the tiers above — do not use for new deployments):
#   STRIPE_PRACTICE_STARTER_PRICE_ID → core, STRIPE_PRACTICE_PROFESSIONAL_PRICE_ID → growth,
#   STRIPE_PRACTICE_ENTERPRISE_PRICE_ID → scale, STRIPE_PRACTICE_SUBSCRIPTION_PRICE_ID → core.
#   SUBSCRIPTION_PLAN_CONFIG and the claim-limit envs are retired — minutes are the meter.
#
# When SUBSCRIPTION_ENFORCE is set and a price is configured, practices must be active/trialing
# or they are redirected to /billing after login, AND the call gate fails closed: a paid-tier
# practice with a missing price env, an unmapped/mismatched subscription price, or a
# non-active subscription cannot dial. For pilot practices without Stripe, set
# BILLING_SKIP_PRACTICE_IDS before turning enforcement on.
# SUBSCRIPTION_ENFORCE=1
# BILLING_SKIP_PRACTICE_IDS=uuid-one,uuid-two
#
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
# (paste the whsec_ printed by the CLI into STRIPE_WEBHOOK_SECRET while that listen is running.)

# Public patient pay link token TTL (days) for /pay/p/:token (P3-22)
# PUBLIC_PAY_TOKEN_TTL_DAYS=7

# ─── Phase 6: Learning & implementation loop (Notion → research → rank → implement → SMS) ─
# LEARNING_LOOP_ENABLED=1
# NOTION_API_KEY=secret_...
# NOTION_LEARNING_DATABASE_ID=...
# LEARNING_CRON=0 6 * * *
# LEARNING_FEASIBILITY_MIN=65
# LEARNING_MAX_IMPLEMENT_PER_CYCLE=3
# LEARNING_NOTION_STATUS_RESEARCH=Backlog,Ready for research,Not Started
# LEARNING_REPO_ROOT=   # optional; defaults to process.cwd() (Collect-RX-main)
# Research: tries NotebookLM first (default), then Gemini with Google Search grounding, then local codebase only.
# LEARNING_RESEARCH_PROVIDER=notebooklm   # notebooklm | gemini | local
# LEARNING_RESEARCH_TIMEOUT_MS=20000
#
# NotebookLM (Google account / Workspace — unofficial SDK; session-based auth):
# NOTEBOOKLM_NOTEBOOK_ID=   # required for NotebookLM web research
# NOTEBOOKLM_COOKIES=       # optional raw Cookie header (or use NOTEBOOKLM_COOKIES_FILE / ~/.notebooklm/session.json)
# NOTEBOOKLM_COOKIES_FILE=  # optional path to Playwright storage_state.json
# NOTEBOOKLM_RESEARCH_SOURCE=web   # web | drive
# NOTEBOOKLM_RESEARCH_MODE=fast    # fast | deep
#
# Gemini (Google AI Studio / Workspace billing — API key, best for headless hosts without browser cookies):
# GEMINI_API_KEY=           # or GOOGLE_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY
# GEMINI_MODEL=gemini-2.0-flash
#
# Uses ALERT_SMS_TO + Twilio vars for cycle summary texts. See docs/operations/PHASE6-LEARNING-LOOP.md

# ─── Developer tooling (optional) ────────────────────────────────────────────
# Repo MCP helper / scripts default API origin
# COLLECTRX_API_URL=http://localhost:3000
# Playwright e2e (playwright.config.ts + e2e/*.spec.ts)
# E2E_BASE_URL=http://127.0.0.1:3000   # Playwright default; use dev server + proxy if you test against :5173 only
# E2E_PRACTICE_ID=
# E2E_PRACTICE_PASSWORD=changeme
# COLLECTRX_E2E=1   # set automatically by playwright webServer; skips API rate limits and avoids
#                   # process.exit on unhandledRejection (keeps the suite from dying mid-run).
#                   # If you start the app yourself: COLLECTRX_E2E=1 PORT=3000 npm start
#                   # then: E2E_REUSE_SERVER=1 npm run e2e
# E2E_REUSE_SERVER=1  # attach to an already-running :3000 server (must have COLLECTRX_E2E=1)
# test-call.js helper (not Vitest)
# TEST_PHONE_NUMBER=+1...
#
# Test suite environment variables (for Vitest + agent test validation)
# These are used when running npm test and self-tuner rule validation.
# Use Stripe test keys (sk_test_*) — they are not production credentials.
# TEST_STRIPE_SECRET_KEY=sk_test_4eC39HqLyjWDarjtT1zdp7dc
# TEST_STRIPE_WEBHOOK_SECRET=whsec_test_00000000000000000000000000000000

# ─── Optional: AWS SSM for secrets (src/config/secrets.js) ───────────────────
# If you load JWT/DB URL from Parameter Store instead of flat env:
# AWS_REGION=ca-central-1
# SSM_PARAMETER_PATH=/collectrx/production

# ─── Rate limits (tuning) ────────────────────────────────────────────────────
# Implemented in src/server/middleware/rateLimiter.ts — standardLimiter on all /api/*,
# webhookLimiter on Stripe/Vapi/SendGrid/Twilio, authLimiter on POST /api/auth/login.

# ─── ClickHouse (product telemetry — optional) ─────────────────────────────
# Local: from repo root run `docker compose up -d clickhouse`
# Leave CLICKHOUSE_URL blank to accept events in mock mode (no storage).
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USER=collectrx
# CLICKHOUSE_PASSWORD=collectrx_ch_dev_only
# CLICKHOUSE_DB=collectrx_analytics

# ─── Cheat sheet (npm scripts in package.json) ───────────────────────────────
#   npx prisma migrate deploy && npx prisma generate
#   npm run dev          — API :3000 + Vite :5173 (concurrently)
#   npm run dev:backend  — API only (tsx watch)
#   npm run dev:frontend — Vite only
#   npm run start        — API without watch (production-style local)
#   npm run worker       — requires REDIS_URL; RULES_TICK + REMINDER_CYCLE
#   npm test             — Vitest (DB integration cases skip if DATABASE_URL unreachable)
#   npm run e2e          — Playwright (set E2E_PRACTICE_ID after db:seed)
#   npm run e2e:print-id — print a practice UUID for E2E_PRACTICE_ID
#   npm run db:seed      — needs SEED_PRACTICE_PASSWORD
#   npm run storybook    — design system :6006
#   npm run abeldent:discover / abeldent:validate-queries / abeldent:emit-queries — Windows schema mapping
