# ─── CollectRx Backend — Environment Variable Reference ───────────────────────
#
# SECURITY RULES:
#   1. Never commit .env to git — it is in .gitignore
#   2. Never hard-code any secret in source code — always use process.env
#   3. In production, set all variables in Railway → Variables (not in files)
#   4. Rotate VAPI_API_KEY and DATABASE_URL immediately if exposed
#   5. Generate VAPI_WEBHOOK_SECRET: openssl rand -hex 32
#
# Copy to .env and fill in real values for local development.
# When you add routes, update this map and the comment block at the top of src/server/index.ts.

# ─── HTTP API map (mounts in src/server/index.ts) ────────────────────────────
#   GET  /health                        minimal probe (no /api prefix)
#   GET  /api/health                    liveness JSON
#   GET  /api/health/ready              DB ping — readiness (Railway / k8s)
#   GET  /api/health/metrics            counters + deployment flags (redis, EMR webhook, secrets *set* boolean only)
#   POST /api/auth/login                cookie session (stricter rate limit)
#   …/api/billing/*                     Stripe customer portal / practice subscription
#   …/api/stripe/*                      Connect onboarding (raw webhook: POST /api/stripe/webhook)
#   …/api/insurance/*                   claims, queue, PATCH servicedAt, confirm-payment, CSV import,
#                                       POST …/queue/trigger/:claimId (manual dial)
#   …/api/calls/*                       call attempts / scheduling
#   …/api/carriers/*                    GET …/health, POST …/:id/unblock after CARRIER_BLOCK
#   …/api/analytics/*                   collection-rate, funnel, carrier-performance, etc.
#   …/api/eligibility/*                 estimate, status (DB snapshot), reconcile (+ audit log)
#   GET  /api/queue/priority-scores     multi-factor ranking (?practiceId= required)
#   POST /api/webhooks/vapi             Vapi call.ended (raw body + x-vapi-signature)
#   POST /api/webhooks/sendgrid         SendGrid events (Ed25519 key) — wire in SendGrid UI
#   POST /api/twilio/sms                inbound SMS (signature; set TWILIO_SMS_INBOUND_URL)
#   AbelDent Windows agent: RAILWAY_API_URL + RAILWAY_API_TOKEN (see below).

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # Set to "production" on Railway
# Trust X-Forwarded-For (1 hop) for req.ip + rate limiting. Set explicitly if not using production auto-enable.
# TRUST_PROXY=1

# P6-01: JSON access logs to stdout (off if LOG_JSON=0; default on when NODE_ENV=production)
# LOG_JSON=1
# Verbose audit samples in non-production (legacy logger path in src/logger.js)
# EMIT_AUDIT_SAMPLE=true
# P6-02: Sentry (optional — server + build-time client DSN)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=   # optional override; server defaults to RAILWAY_GIT_COMMIT_SHA when set (Railway injects this)
# RAILWAY_GIT_COMMIT_SHA=   # set automatically on Railway — used for Sentry release tagging
# Vite / browser (set when building the SPA)
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# ─── Database (required) ─────────────────────────────────────────────────────
# Use any PostgreSQL you already run (Homebrew, Postgres.app, RDS, Neon, etc.).
#
# Railway from your Mac: use the PUBLIC connection string (Connect tab → public host,
# often *.rlwy.net or similar). Hosts ending in .railway.internal only work inside Railway.
# Do not copy placeholder user:password like USER:PASSWORD — use the full URL Railway gives you.
#
# Local default (repo-root `docker compose up -d`):
# Docker Postgres from repo root: `docker compose up -d` (published on host port 5433; see docker-compose.yml)
DATABASE_URL=postgresql://collectrx:collectrx_local_dev_only@localhost:5433/collectrx
# If you use another Postgres, replace user/password/db (do not leave placeholder text):
# DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb
# Staging/production: set in the host — never commit real secrets.
# Hosted Postgres (Neon, Supabase, etc.): use the vendor’s “transaction” / Prisma pooler URL if they offer one;
# avoid mixing pgbouncer transaction mode with Prisma settings that expect session mode unless docs say otherwise.
# Migrations: from monorepo root `collectrx-platform/`: npm run db:migrate:collectrx
#   Or from here: npm run db:migrate:collectrx  (same as db:migrate)

# JWT signing secret for practice session cookies (required in production)
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_32
# Stripe Connect onboard refresh/complete URLs include ?v= HMAC; defaults to JWT_SECRET. Set a dedicated value
# if you rotate JWT_SECRET and must not break in-flight Stripe AccountLink redirects (openssl rand -hex 32).
# STRIPE_ONBOARD_RETURN_SECRET=

# Patient-facing links in reminder messages (no trailing slash). In production set to your deployed app URL.
PUBLIC_APP_URL=http://localhost:5173
# P4-02: base URL of the **API** for one-click email unsubscribe links in reminders. If the API and Vite
# are on the same public host, you can leave unset and it defaults to http://localhost:3000 in dev; in
# production set to your API origin, e.g. https://api.yourdomain.com
# PUBLIC_API_BASE_URL=https://your-api.example.com
# P4-02: optional; defaults to JWT_SECRET. Recommended separate value in production (openssl rand -hex 32).
# EMAIL_UNSUBSCRIBE_SECRET=
# Optional: shown in collection messages; otherwise copy says "our office"
# PRACTICE_BILLING_PHONE=+1-555-555-0100

# ─── Vapi ─────────────────────────────────────────────────────────────────────
# VAPI_API_KEY: dashboard.vapi.ai → API Keys
# TREAT LIKE A PASSWORD — rotate immediately if ever exposed
VAPI_API_KEY=your_vapi_api_key_id_here

# VAPI_SQUAD_ID — dashboard → Squads → ID (required for outbound squad calls from src/vapi/client.ts)
# VAPI_SQUAD_ID=

# VAPI_PHONE_NUMBER_ID: dashboard.vapi.ai → Phone Numbers → your number → ID
VAPI_PHONE_NUMBER_ID=your_phone_number_uuid_here

# Optional default practice UUID embedded in Vapi metadata when PRACTICE_ID is not passed per-call
# PRACTICE_ID=

# VAPI_WEBHOOK_SECRET (must match what Vapi sends in x-vapi-secret; see below)
# Vapi no longer always shows a simple “Server secret” on the phone number screen.
# Current approach: Custom Credentials (Dashboard) → create credential for legacy
# X-Vapi-Secret behavior (Bearer, header "X-Vapi-Secret", no Bearer prefix), OR leave
# unset in dev (verification skipped; see src/middleware/security.js).
# Docs: https://docs.vapi.ai/server-url/server-authentication
# You choose the token: e.g. run `openssl rand -hex 32` and paste the SAME value here
# and in Vapi for that credential.
VAPI_WEBHOOK_SECRET=your_webhook_signing_token_here
# P4-05: Vapi server URL in dashboard → https://YOUR_API_HOST/api/webhooks/vapi (raw body + HMAC; same secret as above).
# Optional: if you rely on server `assistant-request`, set a saved assistant to return from the webhook.
# VAPI_DEFAULT_ASSISTANT_ID=

# ─── SendGrid (P4-01) & Twilio (P4-03) ───────────────────────────────────────
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=
# P4-01: SendGrid → Settings → Webhooks → Event Webhook: paste signing key (Ed25519) for /api/webhooks/sendgrid
# Required in production — unsigned requests return 401.
# SENDGRID_EVENT_WEBHOOK_VERIFICATION_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# P4-03: exact public URL Twilio uses for "A message comes in" (must match signature validation)
# TWILIO_SMS_INBOUND_URL=https://your-app.up.railway.app/api/twilio/sms

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173
# Local only: relax strict rate limits for 127.0.0.1 (see src/middleware/security.js). Never set in production.
# ALLOW_STRICT_LIMIT_LOCALHOST_BYPASS=true

# ─── Practice (single-practice mode) ─────────────────────────────────────────
PRACTICE_NAME=Your Dental Practice Name
PRACTICE_PHONE=+16135551234
PRACTICE_FAX=+16135555678
PRACTICE_EMAIL=billing@yourpractice.com
PRACTICE_ADDRESS=123 Main Street
PRACTICE_CITY=Ottawa
PRACTICE_PROVINCE=ON
PRACTICE_POSTAL=K1A 0A9
PRACTICE_NPI=your_npi_here
PRACTICE_TAX_ID=your_tax_id_here
PRIMARY_DENTIST=Dr. First Last
SECONDARY_DENTIST=Dr. First Last
PRACTICE_PROVIDER_ID=           # Sun Life / Manulife provider ID
PRACTICE_CDCP_PROVIDER_NUMBER=  # 6-digit CDCP provider number

# ─── Queue Cost Controls ──────────────────────────────────────────────────────
QUEUE_MIN_DAYS_OUTSTANDING=14     # Don't call claims under 14 days old
QUEUE_MIN_CLAIM_VALUE=100         # Don't call claims under $100
QUEUE_MAX_ATTEMPTS_BEFORE_REVIEW=3  # Escalate to human after 3 failed attempts
QUEUE_MAX_CALLS_PER_RUN=20        # Cap calls per run to control costs

# ─── Escalation Alerts ────────────────────────────────────────────────────────
# Webhook JSON is de-identified (IDs + reason code only) so Slack/Teams without a BAA does not receive PHI.
# Must be https:// to prevent SSRF
ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# Front desk — immediate Twilio SMS + optional voice (runs before Slack webhook).
# E.164, comma-separated for multiple handsets. Requires TWILIO_* + TWILIO_FROM_NUMBER.
# Example main line: ESCALATION_STAFF_PHONE=+16138372121
# ESCALATION_STAFF_PHONE=
# Voice: urgent (default) = ring desk on urgent escalations only; all = every escalation; never = SMS only
# ESCALATION_STAFF_VOICE_RING=urgent

# ─── Testing Only ─────────────────────────────────────────────────────────────
# When set, ALL calls go to this number — not real insurance carriers.
# DELETE (do not blank out) this variable before going live.
# TEST_PHONE_OVERRIDE=6135018951

# Required for `npm run db:seed` — no default (avoid weak production seeds).
# SEED_PRACTICE_PASSWORD=your-long-random-practice-password

# ─── Deployment / public URLs ─────────────────────────────────────────────────
# Never commit real Railway internal URLs with passwords. Use Railway UI → Variables.
#
# SERVER_URL — origin of this API (no trailing slash). Stripe Connect return URLs, webhook base hints.
# SERVER_URL=http://localhost:3000
#
# FRONTEND_URL — SPA origin for Checkout / Billing Portal return URLs (billing.ts falls back to PUBLIC_APP_URL).
# FRONTEND_URL=http://localhost:5173
#
# ALLOWED_ORIGINS — comma-separated CORS origins (include every Vite port and production host you use).
# ALLOWED_ORIGINS=http://localhost:5173

# ─── AbelDent desktop sync (Windows SQL Server → API; optional on dev Mac) ───
# Discovery: npm run abeldent:discover -- --server "localhost\\SQLEXPRESS" --database AbelDent
# Then copy schema-map.example.json → schema-map.json and run abeldent:validate-queries.
# ABELDENT_SERVER=(local)\\ABELDENT
# ABELDENT_DATABASE=AbelDent
# Path to schema map JSON (desktop agent also accepts SCHEMA_MAP_PATH)
# ABELDENT_SCHEMA_MAP=./schema-map.json
# SCHEMA_MAP_PATH=./schema-map.json
# API the Windows service POSTs to (no trailing slash)
# RAILWAY_API_URL=https://your-api.example.com
# RAILWAY_API_TOKEN=            # long-lived bearer the API accepts for sync uploads
# ABELDENT_PRACTICE_ID=        # practice UUID for multi-tenant uploads
# SYNC_INTERVAL_MINUTES=15     # poll / push cadence for desktop/services/abeldent-sync.js
# ABELDENT_MIN_DAYS=14         # min claim age before syncing as candidate
# ABELDENT_MIN_DAYS_BALANCE=7  # min age for balance-led sync
# Override discovered patient ledger table name if your schema differs
# ABELDENT_PATIENT_LEDGER_TABLE=

# ─── Electron desktop (packaged app) ──────────────────────────────────────────
# Packaged CollectRx does NOT read this .env. The window loads a hosted URL (Railway, etc.).
# If you see Railway "404 / train", the dashboard URL is wrong or nothing is deployed there.
#
# Set the real public URL using either:
#   • macOS: one line in ~/Library/Application Support/dental-ar-system/dashboard-url.txt
#     (same value as your live app, e.g. https://YOUR_SERVICE.up.railway.app — then restart the app)
#   • Advanced: launch with COLLECTRX_DASHBOARD_URL=https://...
# The fallback https://collectrx.up.railway.app in code is only an example host.
# COLLECTRX_DASHBOARD_URL=https://your-hosted-spa.up.railway.app
# desktop/main.js (legacy): COLLECTRX_FRONTEND_URL — same idea as dashboard URL for some builds
# COLLECTRX_FRONTEND_URL=

# ─── Phase 8: background jobs (BullMQ + Redis) ────────────────────────────────
# If set, the API registers repeatable jobs in Redis; run a separate worker with the same env:
#   npm run worker
# Worker process: DATABASE_URL + REDIS_URL required. Rules tick runs EMR outbox drain + priority sync + balances.
# If REDIS_URL is unset, rules + reminders run in-process on the API only (dev default).
# When set, the API also uses Redis for express-rate-limit counters (shared across multiple API replicas).
# REDIS_URL=redis://default:password@host:port
# Optional: on secondary API replicas, set to 1 or true to skip registering Bull repeatables (see docs/operations/PHASE8-BACKGROUND.md)
# DISABLE_SCHEDULER=1
# Daily reminder cron for REMINDER_CYCLE job (node-cron syntax). Default 09:00 server local time.
# REMINDER_CRON=0 9 * * *
# Stagger between pending call_queue rows after each priority sync (ms). Default 60000.
# PRIORITY_QUEUE_SLOT_MS=60000
#
# Ops: GET /api/health/metrics — http, vapi, emrOutbox, uptime, deployment flags (redis set?, scheduler off?, EMR URL set?, booleans only).
#
# Vapi call.ended: prefer structured end-of-call on `metadata.collectrx` or `analysis.collectrx`:
#   { "schemaVersion": 1, "callOutcome": "RESOLVED", "claimStatus": "APPROVED_PENDING_PAYMENT", "outcomeDetail": "…", "carrierBlockDetected": false }
#
# Insurance claims: run `npx prisma migrate deploy` after pull — adds `serviced_at` + `APPROVED_PENDING_PAYMENT`
# on `insurance_claims` / `claim_status`. Backfill `serviced_at` from your PMS for accurate appeal deadlines.
# REST: PATCH /api/insurance/claims/:id (servicedAt), POST /api/insurance/claims/:id/confirm-payment (practice payment → RESOLVED + EMR outbox).
#
# ─── EMR sync outbox (claim RESOLVED → practice PMS / AbelDent bridge) ─────────
# Rows are written to `emr_sync_outbox` from Vapi (CLAIM_RESOLVED) and confirm-payment (PAYMENT_CONFIRMED).
# Each rules-engine tick (in-process every 60s or BullMQ RULES_TICK) drains a batch:
#   • Production: set EMR_SYNC_WEBHOOK_URL to your HTTPS receiver; 2xx marks the row processed (retries on failure).
#   • Optional EMR_SYNC_WEBHOOK_SECRET — sent as Authorization: Bearer …
#   • Local dev without a bridge: EMR_OUTBOX_DEV_ACK=1 clears the queue with logs only (do not use in production).
#   • EMR_OUTBOX_BATCH_SIZE=20 — max rows attempted per tick (1–100).
# EMR_SYNC_WEBHOOK_URL=
# EMR_SYNC_WEBHOOK_SECRET=
# EMR_OUTBOX_DEV_ACK=0
# EMR_OUTBOX_BATCH_SIZE=20

# ─── Stripe (Connect + Billing + webhooks) ───────────────────────────────────
# Railway / production: set STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET in the host UI (never commit real keys).
# One webhook endpoint receives Connect events AND platform subscription events:
#   https://YOUR_API_ORIGIN/api/stripe/webhook
# Enable at least: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted,
# account.updated, payment_intent.succeeded (Connect emits these — patient pay is credited from checkout.session.completed).
#
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Platform subscription (practice pays CollectRx) — create a recurring Price in Stripe Dashboard, then:
# STRIPE_PRACTICE_SUBSCRIPTION_PRICE_ID=price_...
#
# When both SUBSCRIPTION_ENFORCE and STRIPE_PRACTICE_SUBSCRIPTION_PRICE_ID are set, practices must be active/trialing
# or they are redirected to /billing after login. For existing pilot practices, set BILLING_SKIP_PRACTICE_IDS or
# run a one-time SQL to set subscriptionStatus before turning enforcement on.
# SUBSCRIPTION_ENFORCE=true
# BILLING_SKIP_PRACTICE_IDS=uuid-one,uuid-two
#
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
# (paste the whsec_ printed by the CLI into STRIPE_WEBHOOK_SECRET while that listen is running.)

# Public patient pay link token TTL (days) for /pay/p/:token (P3-22)
# PUBLIC_PAY_TOKEN_TTL_DAYS=7

# ─── Developer tooling (optional) ────────────────────────────────────────────
# Repo MCP helper / scripts default API origin
# COLLECTRX_API_URL=http://localhost:3000
# Playwright e2e (playwright.config.ts + e2e/*.spec.ts)
# E2E_BASE_URL=http://127.0.0.1:3000   # Playwright default; use dev server + proxy if you test against :5173 only
# E2E_PRACTICE_ID=
# E2E_PRACTICE_PASSWORD=changeme
# test-call.js helper (not Vitest)
# TEST_PHONE_NUMBER=+1...

# ─── Optional: AWS SSM for secrets (src/config/secrets.js) ───────────────────
# If you load JWT/DB URL from Parameter Store instead of flat env:
# AWS_REGION=ca-central-1
# SSM_PARAMETER_PATH=/collectrx/production

# ─── Rate limits (tuning) ────────────────────────────────────────────────────
# Implemented in src/server/middleware/rateLimiter.ts — standardLimiter on all /api/*,
# webhookLimiter on Stripe/Vapi/SendGrid/Twilio, authLimiter on POST /api/auth/login.

# ─── Cheat sheet (npm scripts in package.json) ───────────────────────────────
#   npx prisma migrate deploy && npx prisma generate
#   npm run dev          — API :3000 + Vite :5173 (concurrently)
#   npm run dev:backend  — API only (tsx watch)
#   npm run dev:frontend — Vite only
#   npm run start        — API without watch (production-style local)
#   npm run worker       — requires REDIS_URL; RULES_TICK + REMINDER_CYCLE
#   npm test             — Vitest (DB integration cases skip if DATABASE_URL unreachable)
#   npm run e2e          — Playwright (set E2E_PRACTICE_ID after db:seed)
#   npm run e2e:print-id — print a practice UUID for E2E_PRACTICE_ID
#   npm run db:seed      — needs SEED_PRACTICE_PASSWORD
#   npm run storybook    — design system :6006
#   npm run abeldent:discover / abeldent:validate-queries / abeldent:emit-queries — Windows schema mapping
