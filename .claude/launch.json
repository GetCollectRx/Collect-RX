{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "collectrx-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:frontend",
        "--prefix",
        "Collect-RX-main"
      ],
      "port": 5173
    },
    {
      "name": "collectrx-audit-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:frontend",
        "--prefix",
        "Collect-RX-main"
      ],
      "port": 5174,
      "env": {
        "VITE_DEV_SERVER_PORT": "5174",
        "VAPI_API_KEY": "disabled-for-audit",
        "VAPI_BASE_URL": "http://127.0.0.1:1"
      }
    }
  ]
}