{
  "name": "phi-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone PHI redaction, synthetic data, and retention verification tools for CollectRx",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "phi-guard-synthetic": "dist/synthetic/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "20.19.42",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7",
    "zod": "4.6.5"
  }
}
